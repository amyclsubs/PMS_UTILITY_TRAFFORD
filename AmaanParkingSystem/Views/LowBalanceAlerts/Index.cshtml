                                    <div class="col text-success"><h6>Healthy</h6><h2>${data.HealthyBalanceCount || 0}</h2></div>
                                    <div class="col text-info"><h6>Deposit</h6><h2>KES ${parseFloat(data.TotalDeposit || 0).toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</h2></div>
                                    <div class="col text-dark"><h6>Collected</h6><h2>KES ${parseFloat(data.ToBeCollected || 0).toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</h2></div>
                                </div>
                            </div>
                        </div>`;
                }
            } catch (error) {
                resultDiv.innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
            }
        }

        function showMessage(message, type) {
            var alertDiv = $('#statusMessage');
            alertDiv.removeClass().addClass('alert alert-' + type).html(message).fadeIn();
            setTimeout(function() { alertDiv.fadeOut(); }, 5000);
        }
    </script>
}