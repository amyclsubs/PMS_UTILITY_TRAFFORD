    <!-- ✅ GLOBAL DUPLICATE / SUCCESS / ERROR POPUP TOAST -->
    <!-- Toast Container -->
    <div id="toast-container" style="
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 99999;
    display: flex;
    flex-direction: column;
    gap: 12px;
    pointer-events: none;
    max-width: 580px;
    width: 90%;
"></div>

    <style>
        .pms-toast {
            display: flex;
            align-items: flex-start;
            gap: 18px;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.10);
            padding: 28px 30px;
            pointer-events: all;
            min-width: 480px;
            max-width: 580px;
            border-left: 7px solid #ccc;
            animation: toastSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            position: relative;
            overflow: hidden;
        }

            .pms-toast.toast-error {
                border-left-color: #dc3545;
            }

            .pms-toast.toast-success {
                border-left-color: #28a745;
            }

            .pms-toast.toast-warning {
                border-left-color: #fd7e14;
            }

            .pms-toast .toast-icon {
                font-size: 36px !important;
                flex-shrink: 0;
                margin-top: 2px;
            }

            .pms-toast .toast-body {
                flex: 1;
            }

            .pms-toast .toast-title {
                font-weight: 700 !important;
                font-size: 20px !important;
                margin-bottom: 8px !important;
                color: #1a1a1a !important;
            }

            .pms-toast .toast-msg {
                font-size: 16px !important;
                color: #444444 !important;
                line-height: 1.6 !important;
                word-break: break-word;
            }

            .pms-toast .toast-close {
                background: none !important;
                border: none !important;
                font-size: 24px !important;
                color: #999 !important;
                cursor: pointer !important;
                padding: 0 !important;
                line-height: 1;
                flex-shrink: 0;
                margin-top: -2px;
                transition: color 0.2s;
            }

                .pms-toast .toast-close:hover {
                    color: #333 !important;
                }

            .pms-toast .toast-progress {
                position: absolute;
                bottom: 0;
                left: 0;
                height: 4px;
                border-radius: 0 0 0 14px;
                animation: toastProgress 5s linear forwards;
            }

        .toast-error .toast-progress {
            background: #dc3545;
        }

        .toast-success .toast-progress {
            background: #28a745;
        }

        .toast-warning .toast-progress {
            background: #fd7e14;
        }

        @@keyframes toastSlideIn {
            from {
                opacity: 0;
                transform: translateX(60px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes toastSlideOut {
            from {
                opacity: 1;
                transform: translateX(0);
                max-height: 200px;
                margin-bottom: 0;
            }

            to {
                opacity: 0;
                transform: translateX(60px);
                max-height: 0;
                margin-bottom: -12px;
                padding: 0;
            }
        }

        @@keyframes toastProgress {
            from {
                width: 100%;
            }

            to {
                width: 0%;
            }
        }
    </style>

    <script>
        function showPmsToast(type, title, message) {
            const container = document.getElementById('toast-container');
            const icons = { error: '❌', success: '✅', warning: '⚠️' };

            const toast = document.createElement('div');
            toast.className = `pms-toast toast-${type}`;
            toast.innerHTML = `
                <span class="toast-icon">${icons[type] || 'ℹ️'}</span>
                <div class="toast-body">
                    <div class="toast-title">${title}</div>
                    <div class="toast-msg">${message}</div>
                </div>
                <button class="toast-close" onclick="dismissToast(this.parentElement)">✕</button>
                <div class="toast-progress"></div>
            `;

            container.appendChild(toast);

            // Auto dismiss after 5 seconds
            const timer = setTimeout(() => dismissToast(toast), 5000);
            toast._timer = timer;
        }

        function dismissToast(toast) {
            if (!toast || toast._dismissed) return;
            toast._dismissed = true;
            clearTimeout(toast._timer);
            toast.style.animation = 'toastSlideOut 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards';
            setTimeout(() => toast.remove(), 350);
        }

        // ✅ Read TempData values injected by Razor below and fire toasts on page load
        document.addEventListener('DOMContentLoaded', function () {

            // TempData["ErrorMessage"] — used by ParkerCompanyController, ParkerCompanyMasterController, UserManagementController
            var errorMsg = '@Html.Raw(TempData["ErrorMessage"]?.ToString()?.Replace("'", "\\'") ?? "")';
            if (errorMsg.trim() !== '') {
                showPmsToast('error', 'Already Exists!', errorMsg);
            }

            // TempData["SuccessMessage"] — used by ParkerCompanyController, ParkerCompanyMasterController
            var successMsg = '@Html.Raw(TempData["SuccessMessage"]?.ToString()?.Replace("'", "\\'") ?? "")';
            if (successMsg.trim() !== '') {
                showPmsToast('success', 'Success!', successMsg);
            }


            // RBAC access-denied message (set server-side when role blocks a page)
            var rbacMsg = '@Html.Raw(rbacDeniedMsg.Replace("'", "\'"))';
            if (rbacMsg.trim() !== '') {
                showPmsToast('warning', 'Access Denied', rbacMsg);
            }
            // TempData["Message"] — used by SiteController
            var siteMsg = '@Html.Raw(TempData["Message"]?.ToString()?.Replace("'", "\\'") ?? "")';
            if (siteMsg.trim() !== '') {
                var type = siteMsg.includes('❌') ? 'error' : 'success';
                var title = type === 'error' ? 'Already Exists!' : 'Success!';
                showPmsToast(type, title, siteMsg.replace('❌ ', ''));
            }
        });
    </script>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // OPTIMIZED TAB MANAGEMENT SYSTEM - NO LAG (ONE TAB PER MODULE)
        let openTabs = [];
        let isInitialized = false;

        // --- helper: normalize any URL to a module tab key ---
                function getTabKey(rawUrl) {
            const u = new URL(rawUrl, window.location.origin);
            let path = u.pathname;

            // Site Management (already working)
            if (path.startsWith('/Site/Index')) return '/Site/Index';

            // Parker Company MASTER
            // List page:   /ParkerCompanyMaster/Index
            // Edit page:   /ParkerCompanyMaster/EditParkerCompanyMaster/{id}
            if (path.startsWith('/ParkerCompanyMaster')) return '/ParkerCompanyMaster/ParkerCompanyMaster';

            // Parker Company SUB
            // List page:   /ParkerCompany/Index
            // Edit page:   /ParkerCompany/EditParkerCompany/{id}
            if (path.startsWith('/ParkerCompany')) return '/ParkerCompany';

            // Card Registration
            // List page:   /UserManagement/CardRegistration
            // Edit page:   /UserManagement/CardRegistration/{id}
            if (path.startsWith('/UserManagement/CardRegistration'))
                return '/UserManagement/CardRegistration';

           if (path.startsWith("/RealTimeReport")) return "/RealTimeReport";
           if (path.startsWith("/B2Notification")) return "/B2Notification";

            // Add similar rules here if you see other modules with edit pages.
            return path; // default: use full pathname
        }

        function addTab(url, title, icon) {
            const key = getTabKey(url);

            const existingTabIndex = openTabs.findIndex(tab => tab.url === key);
            if (existingTabIndex !== -1) {
                activateTabByIndex(existingTabIndex);
                return;
            }

            const tab = { url: key, title, icon };
            openTabs.push(tab);
            renderNewTab(tab);
            saveTabsToStorage();
        }

        function closeTab(url, event) {
            event.stopPropagation();
            event.preventDefault();

            const key = getTabKey(url);
            const tabIndex = openTabs.findIndex(tab => tab.url === key);
            if (tabIndex === -1) return;

            const isCurrentPage = getTabKey(window.location.href) === key;

            openTabs.splice(tabIndex, 1);

            const tabBar = document.getElementById('tabBar');
            const tabElements = tabBar.querySelectorAll('.tab-item');
            if (tabElements[tabIndex]) {
                tabElements[tabIndex].remove();
            }

            saveTabsToStorage();

            if (isCurrentPage && openTabs.length > 0) {
                const newActiveTab = openTabs[Math.max(0, tabIndex - 1)];
                window.location.href = newActiveTab.url;
            }
        }

        function activateTabByIndex(index) {
            const tabBar = document.getElementById('tabBar');
            const tabElements = tabBar.querySelectorAll('.tab-item');
            tabElements.forEach(el => el.classList.remove('active'));
            if (tabElements[index]) tabElements[index].classList.add('active');
        }

        function renderNewTab(tab) {
            const tabBar = document.getElementById('tabBar');
            const isActive = getTabKey(window.location.href) === tab.url;

            const tabElement = document.createElement('div');
            tabElement.className = 'tab-item' + (isActive ? ' active' : '');
            tabElement.onclick = () => { pmsTabSaveState(); window.location.href = tab.url; };

            tabElement.innerHTML = `
                <i class="${tab.icon} tab-icon"></i>
                <span class="tab-title" title="${tab.title}">${tab.title}</span>
                <span class="tab-close" onclick="closeTab('${tab.url}', event)">
                    <i class="fas fa-times"></i>
                </span>
            `;
            const tabsContainer = document.getElementById('tabsContainer') || tabBar;
            tabsContainer.appendChild(tabElement);
        }

        function renderAllTabs() {
            const tabBar = document.getElementById('tabBar');
            const currentKey = getTabKey(window.location.href);
            const fragment = document.createDocumentFragment();

            openTabs.forEach(tab => {
                const isActive = currentKey === tab.url;

                const tabElement = document.createElement('div');
                tabElement.className = 'tab-item' + (isActive ? ' active' : '');
                tabElement.onclick = () => { pmsTabSaveState(); window.location.href = tab.url; };

                tabElement.innerHTML = `
                    <i class="${tab.icon} tab-icon"></i>
                    <span class="tab-title" title="${tab.title}">${tab.title}</span>
                    <span class="tab-close" onclick="closeTab('${tab.url}', event)">
                        <i class="fas fa-times"></i>
                    </span>
                `;
                fragment.appendChild(tabElement);
            });

            const tabsContainer = document.getElementById('tabsContainer');
            if (tabsContainer) {
                tabsContainer.innerHTML = '';
                tabsContainer.appendChild(fragment);
            } else {
                tabBar.innerHTML = '';
                tabBar.appendChild(fragment);
            }
        }

        function saveTabsToStorage() {
            if ('requestIdleCallback' in window) {
                requestIdleCallback(() => {
                    localStorage.setItem('openTabs', JSON.stringify(openTabs));
                });
            } else {
                setTimeout(() => {
                    localStorage.setItem('openTabs', JSON.stringify(openTabs));
                }, 0);
            }
        }

        function initializeTabs() {
            if (isInitialized) return;
            isInitialized = true;

            const savedTabs = localStorage.getItem('openTabs');
            if (savedTabs) {
                try { openTabs = JSON.parse(savedTabs); } catch { openTabs = []; }
            }

            const currentKey = getTabKey(window.location.href);
            const pageTitle = document.querySelector('.page-header h2')?.textContent?.trim()
                           || document.title.split('-')[0]?.trim()
                           || 'Page';
            const currentIcon = 'fas fa-file';

            if (!openTabs.find(tab => tab.url === currentKey)) {
                openTabs.push({ url: currentKey, title: pageTitle, icon: currentIcon });
            }

            renderAllTabs();
            saveTabsToStorage();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeTabs);
        } else {
            initializeTabs();
        }

        // Sidebar links – create/reuse module tab, navigate in same browser tab
        document.addEventListener('click', function (e) {
            const link = e.target.closest('.sidebar-nav-link, .sidebar-submenu-link');
            if (link && link.href && !link.href.includes('#')) {
                const url = link.href;
                const title = link.getAttribute('data-tab-title') || link.textContent.trim();
                const icon = link.getAttribute('data-tab-icon') || 'fas fa-file';
                addTab(url, title, icon);
                // No preventDefault: browser navigation is normal
            }
        }, true);

        // Edit links – reuse same module tab (Site, Parker Company, Card, etc.)
        document.addEventListener('click', function (e) {
            const editLink = e.target.closest('a');
            if (!editLink || !editLink.href) return;

            const href = editLink.href;

            if (href.includes('/Site/Index')
                || href.includes('/ParkerCompanyMaster/Index')
                || href.includes('/ParkerCompanySub/Index')
                || href.includes('/CardRegistration/Index')) {

                const title = editLink.getAttribute('data-tab-title')
                            || document.querySelector('.page-header h2')?.textContent?.trim()
                            || 'Edit';
                const icon = editLink.getAttribute('data-tab-icon') || 'fas fa-edit';

                addTab(href, title, icon);
                // Browser still goes to full /.../Index/{id} in same browser tab
            }
        }, true);

        // SIDEBAR TOGGLE - unchanged
        (function initSidebar() {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            const toggleIcon = toggleBtn.querySelector('i');

            let isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';

            sidebar.style.transition = 'none';
            mainContent.style.transition = 'none';
            toggleBtn.style.transition = 'none';

            if (isCollapsed) {
                sidebar.style.marginLeft = '-260px';
                mainContent.style.marginLeft = '0';
                toggleBtn.style.left = '15px';
                toggleIcon.className = 'fas fa-chevron-right';
            } else {
                toggleBtn.style.left = '220px';
            }

            setTimeout(() => {
                sidebar.style.transition = '';
                mainContent.style.transition = '';
                toggleBtn.style.transition = '';
            }, 50);

            toggleBtn.addEventListener('click', function () {
                isCollapsed = !isCollapsed;

                if (isCollapsed) {
                    sidebar.style.marginLeft = '-260px';
                    mainContent.style.marginLeft = '0';
                    toggleBtn.style.left = '15px';
                    toggleIcon.className = 'fas fa-chevron-right';
                } else {
                    sidebar.style.marginLeft = '0';
                    mainContent.style.marginLeft = 'var(--sidebar-width)';
                    toggleBtn.style.left = '220px';
                    toggleIcon.className = 'fas fa-chevron-left';
                }

                localStorage.setItem('sidebarCollapsed', isCollapsed);
            });
        })();

        // Sidebar submenu toggle - unchanged
        document.addEventListener('click', function (e) {
            const toggleLink = e.target.closest('[data-toggle="submenu"]');
            if (!toggleLink) return;

            e.preventDefault();

            const targetId = toggleLink.getAttribute('data-target');
            const submenu = document.getElementById(targetId);
            if (!submenu) return;

            const isCollapsed = submenu.classList.contains('collapsed');

            const allSubmenus = document.querySelectorAll('.sidebar-submenu');
            allSubmenus.forEach(menu => {
                if (menu.id !== targetId && !menu.classList.contains('collapsed')) {
                    menu.classList.add('collapsed');
                    const prevLink = menu.previousElementSibling;
                    if (prevLink) prevLink.classList.add('collapsed');
                }
            });

            if (isCollapsed) {
                submenu.classList.remove('collapsed');
                toggleLink.classList.remove('collapsed');
            } else {
                submenu.classList.add('collapsed');
                toggleLink.classList.add('collapsed');
            }
        });

        // Search – unchanged
        (function initSearch() {
            const searchInput = document.getElementById('sidebarSearch');
            let searchTimeout;

            searchInput.addEventListener('input', function (e) {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    const searchTerm = e.target.value.toLowerCase();
                    const allLinks = document.querySelectorAll('.sidebar-nav-link, .sidebar-submenu-link');

                    allLinks.forEach(link => {
                        const text = link.textContent.toLowerCase();
                        const parent = link.closest('.sidebar-nav-item, .sidebar-submenu-item');
                        if (parent) {
                            parent.style.display = text.includes(searchTerm) ? '' : 'none';
                        }
                    });
                }, 150);
            });
        })();

        // Active link – unchanged
        (function setActiveLink() {
            const currentUrl = window.location.href;
            const allLinks = document.querySelectorAll('.sidebar-nav-link, .sidebar-submenu-link');

            for (let link of allLinks) {
                if (link.href === currentUrl) {
                    link.classList.add('active');

                    const parentSubmenu = link.closest('.sidebar-submenu');
                    if (parentSubmenu) {
                        parentSubmenu.classList.remove('collapsed');
                        const parentLink = parentSubmenu.previousElementSibling;
                        if (parentLink) parentLink.classList.remove('collapsed');
                    }
                    break;
                }
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // ── PMS TAB STATE: Save scroll + form data before tab navigation ──────
        // pmsTabSaveState() is called synchronously inside every tab onclick,
        // guaranteeing it runs before window.location.href changes.
        function pmsTabSaveState() {
            try {
                var key = 'pms_state:' + window.location.pathname + window.location.search;
                var state = {};

                // Scroll — .content-area is the scrollable div in this layout
                var ca = document.querySelector('.content-area');
                state.scroll = ca ? ca.scrollTop : (window.scrollY || 0);

                // All form inputs
                state.form = {};
                document.querySelectorAll('input, textarea, select').forEach(function (el) {
                    var k = el.name || el.id;
                    if (!k) return;
                    if (el.type === 'password' || el.type === 'file'   ||
                        el.type === 'submit'   || el.type === 'button' ||
                        el.type === 'hidden'   || el.type === 'image') return;
                    if (el.type === 'checkbox' || el.type === 'radio') {
                        state.form[k] = el.checked;
                    } else {
                        state.form[k] = el.value;
                    }
                });

                sessionStorage.setItem(key, JSON.stringify(state));
            } catch (e) { /* silent fail */ }
        }

        // ── Restore state after page loads ───────────────────────────────────
        (function pmsTabRestoreState() {
            try {
                var key = 'pms_state:' + window.location.pathname + window.location.search;
                var raw = sessionStorage.getItem(key);
                if (!raw) return;
                var state = JSON.parse(raw);

                function doRestore() {
                    // Restore form values
                    if (state.form) {
                        document.querySelectorAll('input, textarea, select').forEach(function (el) {
                            var k = el.name || el.id;
                            if (!k || !(k in state.form)) return;
                            if (el.type === 'password' || el.type === 'file'   ||
                                el.type === 'submit'   || el.type === 'button' ||
                                el.type === 'hidden'   || el.type === 'image') return;
                            if (el.type === 'checkbox' || el.type === 'radio') {
                                el.checked = !!state.form[k];
                            } else {
                                el.value = state.form[k];
                            }
                        });
                    }

                    // Restore scroll — double rAF waits for full layout paint
                    if (state.scroll && state.scroll > 0) {
                        requestAnimationFrame(function () {
                            requestAnimationFrame(function () {
                                var ca = document.querySelector('.content-area');
                                if (ca) ca.scrollTop = state.scroll;
                                else window.scrollTo(0, state.scroll);
                            });
                        });
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', doRestore);
                } else {
                    doRestore();
                }
            } catch (e) { /* silent fail */ }
        })();

        // ── Also save before sidebar link navigations ─────────────────────────
        document.addEventListener('click', function (e) {
            var link = e.target.closest('.sidebar-nav-link, .sidebar-submenu-link');
            if (link && link.href && !link.href.includes('#')) {
                pmsTabSaveState();
            }
        }, true);
    </script>
