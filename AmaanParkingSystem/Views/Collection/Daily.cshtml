                                            <th class="text-end">Amount</th>
                                            <!-- Paystation 2 -->
                                            <th class="text-end">Count</th>
                                            <th class="text-end">Amount</th>
                                            <!-- Paystation 3 -->
                                            <th class="text-end">Count</th>
                                            <th class="text-end">Amount</th>
                                            <!-- Paystation 4 -->
                                            <th class="text-end">Count</th>
                                            <th class="text-end">Amount</th>
                                            <!-- HHD 1 -->
                                            <th class="text-end">Count</th>
                                            <th class="text-end">Amount</th>
                                            <!-- HHD 2 -->
                                            <th class="text-end">Count</th>
                                            <th class="text-end">Amount</th>
                                            <!-- HHD 3 -->
                                            <th class="text-end">Count</th>
                                            <th class="text-end">Amount</th>
                                            <!-- HHD 4 -->
