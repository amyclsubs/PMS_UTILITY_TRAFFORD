        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- TAB 2: TRANSACTIONS -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="tab-pane fade" id="transactionsContent">
            <!-- Date Range Selection with Quick Buttons -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <!-- From Date -->
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">From Date</label>
                                    <input type="date" id="dateFromTransactions" class="form-control date-input" />
                                </div>

                                <!-- To Date -->
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">To Date</label>
                                    <input type="date" id="dateToTransactions" class="form-control date-input" />
                                </div>

                                <!-- Show Button -->
                                <div class="col-md-1">
                                    <button onclick="loadDailyDataTransactions()" class="btn btn-primary w-100">
                                        <i class="fas fa-search"></i> Show
                                    </button>
                                </div>

                                <!-- Today Button -->
                                <div class="col-md-1">
                                    <button onclick="loadTodayTransactions()" class="btn btn-info w-100">
                                        <i class="fas fa-calendar-day"></i> Today
                                    </button>
                                </div>

                                <!-- Yesterday Button -->
                                <div class="col-md-2">
                                    <button onclick="loadYesterdayTransactions()" class="btn btn-secondary w-100">
                                        <i class="fas fa-calendar-minus"></i> Yesterday
