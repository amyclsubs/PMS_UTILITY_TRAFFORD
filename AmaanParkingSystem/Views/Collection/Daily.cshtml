@{
    ViewData["Title"] = "Daily Collection Report";
}

<style>
    .stat-box {
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 12px;
        background-color: #f9f9f9;
        text-align: center;
        min-height: 80px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .stat-box .stat-label {
            font-size: 12px;
            color: #666;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .stat-box .stat-value {
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }

        .stat-box.highlight-foc {
            background-color: #c8e6c9;
            border-color: #4caf50;
        }

            .stat-box.highlight-foc .stat-value {
                color: #2e7d32;
            }

        .stat-box.highlight-total {
            background-color: #fff9c4;
            border-color: #fbc02d;
        }

            .stat-box.highlight-total .stat-value {
                color: #f57f17;
            }

    .nav-tabs .nav-link {
        color: #495057;
        border: 1px solid #dee2e6;
    }

        .nav-tabs .nav-link.active {
            color: #495057;
            background-color: #fff;
            border: 1px solid #dee2e6;
            border-bottom: 3px solid #007bff;
        }
</style>

<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header mb-4">
        <h2><i class="fas fa-money-bill"></i> Daily Collection Report</h2>
        <p>Real-time parking collection data from AMAAN_PMS database</p>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" id="exited-tab" data-bs-toggle="tab" data-bs-target="#exitedContent" type="button">
                <i class="fas fa-car"></i> Daily Collection [Exited Cars]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="transactions-tab" data-bs-toggle="tab" data-bs-target="#transactionsContent" type="button">
                <i class="fas fa-receipt"></i> Daily Collection [Transactions]
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content">
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- TAB 1: EXITED CARS -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="tab-pane fade show active" id="exitedContent">
            <!-- Date Range Selection with Quick Buttons -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <!-- From Date -->
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">From Date</label>
                                    <input type="date" id="dateFromExited" class="form-control date-input" />
                                </div>

                                <!-- To Date -->
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">To Date</label>
                                    <input type="date" id="dateToExited" class="form-control date-input" />
                                </div>

                                <!-- Show Button -->
                                <div class="col-md-1">
                                    <button onclick="loadDailyDataExited()" class="btn btn-primary w-100">
                                        <i class="fas fa-search"></i> Show
                                    </button>
                                </div>

                                <!-- Today Button -->
                                <div class="col-md-1">
                                    <button onclick="loadTodayExited()" class="btn btn-info w-100">
                                        <i class="fas fa-calendar-day"></i> Today
                                    </button>
                                </div>

                                <!-- Yesterday Button -->
                                <div class="col-md-2">
                                    <button onclick="loadYesterdayExited()" class="btn btn-secondary w-100">
                                        <i class="fas fa-calendar-minus"></i> Yesterday
                                    </button>
                                </div>

                                <!-- Export Button -->
                                <div class="col-md-2">
                                    <button onclick="exportDailyExited()" class="btn btn-success w-100">
                                        <i class="fas fa-download"></i> Export Excel
                                    </button>
                                </div>

                                <!-- Clear Button -->
                                <div class="col-md-1">
                                    <button onclick="clearDailyExited()" class="btn btn-warning w-100">
                                        <i class="fas fa-redo"></i> Clear
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Method Summary -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">Payment Method Summary</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover" id="exitedPaymentSummaryTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th rowspan="2" style="width: 8%; vertical-align: middle;">Payment Method</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">Server</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">Paystation 1</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">Paystation 2</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">Paystation 3</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">Paystation 4</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">HHD1</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">HHD2</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">HHD3</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">HHD4</th>
                                            <th colspan="2" class="text-center" style="width: 8%;">Web</th>
