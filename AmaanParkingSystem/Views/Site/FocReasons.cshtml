@model AmaanParkingSystem.Controllers.FocReasonController.FocReasonVM

@{
    ViewData["Title"] = "FOC Reasons";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = !string.IsNullOrWhiteSpace(Model?.OriginalReason);
}

<style>
    .foc-form-card {
        max-width: 1100px;
    }

    .foc-table-card {
        max-width: 900px;
    }

    .foc-table {
        width: auto;
        min-width: 650px;
        margin-bottom: 0;
    }

        .foc-table th,
        .foc-table td {
            padding: 0.45rem 0.6rem;
            vertical-align: middle;
            white-space: nowrap;
        }

            .foc-table th:nth-child(1),
            .foc-table td:nth-child(1) {
                width: 180px;
            }

            .foc-table th:nth-child(2),
            .foc-table td:nth-child(2) {
                min-width: 220px;
                white-space: normal;
            }

            .foc-table th:nth-child(3),
            .foc-table td:nth-child(3) {
                width: 150px;
                text-align: center;
            }

        .foc-table .btn {
            padding: 0.2rem 0.45rem;
            font-size: 0.8rem;
        }

        .foc-table .action-cell form {
            display: inline-block;
            margin: 0;
        }
</style>

<div class="page-header">
    <h2>FOC Reasons</h2>
    <p>Create, edit and delete FOC reasons.</p>
</div>

@if (ViewBag.CanWrite == true)
{
    <div class="card foc-form-card mb-3">
        <div class="card-header">
            <h5 class="mb-0">@(isEdit ? "Edit FOC Reason" : "Add FOC Reason")</h5>
        </div>
        <div class="card-body p-3">
            <form asp-controller="FocReason" asp-action="Save" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="OriginalSiteName" />
                <input type="hidden" asp-for="OriginalReason" />

                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="form-label mb-1">Site Name</label>
                        <input asp-for="site_name" class="form-control form-control-sm" />
                        <small class="text-muted">Leave blank if this is a general FOC reason.</small>
                    </div>

                    <div class="col-md-5 mb-2">
                        <label class="form-label mb-1">Reason</label>
                        <input asp-for="Reason" class="form-control form-control-sm" required />
                    </div>

                    <div class="col-md-3 mb-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            @(isEdit ? "Update" : "Save")
                        </button>
                    </div>
                </div>

                @if (isEdit)
                {
                    <a asp-controller="FocReason" asp-action="Index" class="btn btn-secondary btn-sm mt-2">Cancel</a>
                }
            </form>
        </div>
    </div>
}

<div class="card foc-table-card">
    <div class="card-header">
        <h5 class="mb-0">FOC Reason List</h5>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover foc-table">
                <thead>
                    <tr>
                        <th>Site Name</th>
                        <th>Reason</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FocReasonList != null && Model.FocReasonList.Count > 0)
                    {
                        foreach (var item in Model.FocReasonList)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(item.site_name) ? "ALL / GENERAL" : item.site_name)</td>
                                <td>@item.Reason</td>
                                <td class="action-cell">
                                    <a asp-controller="FocReason"
                                       asp-action="Index"
                                       asp-route-editSiteName="@(item.site_name ?? "")"
                                       asp-route-editReason="@item.Reason"
                                       class="btn btn-warning btn-sm @(ViewBag.CanWrite == true ? "" : "d-none")">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>

                                    <form asp-controller="FocReason"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this record?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="site_name" value="@(item.site_name ?? "")" />
                                        <input type="hidden" name="reason" value="@item.Reason" />
                                        <button type="submit" class="btn btn-danger btn-sm @(ViewBag.CanWrite == true ? "" : "d-none")">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>