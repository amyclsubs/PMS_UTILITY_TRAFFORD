@model List<AmaanParkingSystem.Models.Site.SiteModel>
@{
    ViewData["Title"] = "Site Management";
    var editModel = ViewBag.EditModel as AmaanParkingSystem.Models.Site.SiteModel;
    bool isEdit = editModel != null && editModel.id > 0;
}

<div class="container-fluid mt-3">
    <h4 class="mb-3"><i class="fas fa-layer-group"></i> Site Management</h4>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-3">
            <form asp-action="Save" method="post" autocomplete="off">
                <input type="hidden" name="id" value="@(editModel?.id ?? 0)" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label mb-1">Site Name *</label>
                        <input type="text" name="site_name" class="form-control form-control-sm" required
                               value="@(editModel?.site_name ?? "")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label mb-1">Client Name *</label>
                        <input type="text" name="client_name" class="form-control form-control-sm" required
                               value="@(editModel?.client_name ?? "")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label mb-1">Client Email</label>
                        <input type="text" name="client_email" class="form-control form-control-sm"
                               value="@(editModel?.client_email ?? "")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label mb-1">Customer ID</label>
                        <input type="text" name="customer_id" class="form-control form-control-sm"
                               value="@(editModel?.customer_id ?? "")" />
                    </div>
                </div>

                <div class="row g-2 mt-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label mb-1">Site ID</label>
                        <input type="text" name="site_id" class="form-control form-control-sm"
                               value="@(editModel?.site_id ?? "")" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1">Site Type</label>
                        <input type="text" name="site_type" class="form-control form-control-sm"
                               placeholder="e.g. ADMIN" value="@(editModel?.site_type ?? "")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label mb-1">Status</label>
                        @{
                            bool statusVal = editModel?.client_status ?? true;
                        }
                        <select name="client_status" class="form-select form-select-sm">
                            <option value="true" selected="@statusVal">Active</option>
                            <option value="false" selected="@(!statusVal)">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label mb-1">Site Address</label>
                        <input type="text" name="client_site_address" class="form-control form-control-sm"
                               value="@(editModel?.client_site_address ?? "")" />
                    </div>
                </div>

                <div class="row g-2 mt-2">
                    <div class="col-md-6">
                        <label class="form-label mb-1">Email Report Preferences</label>
                        <div class="d-flex flex-wrap small border rounded px-2 py-1">
                            @{
                                bool dExit = editModel?.receive_daily_exited ?? false;
                                bool dTran = editModel?.receive_daily_transactions ?? false;
                                bool mExit = editModel?.receive_monthly_exited ?? false;
                                bool mTran = editModel?.receive_monthly_transactions ?? false;
                            }
                            <div class="form-check form-check-inline me-3">
                                <input class="form-check-input" type="checkbox" name="receive_daily_exited"
                                       value="true" @(dExit ? "checked" : "") />
                                <label class="form-check-label">Daily Exited</label>
                            </div>
                            <div class="form-check form-check-inline me-3">
                                <input class="form-check-input" type="checkbox" name="receive_daily_transactions"
                                       value="true" @(dTran ? "checked" : "") />
                                <label class="form-check-label">Daily Transactions</label>
                            </div>
                            <div class="form-check form-check-inline me-3">
                                <input class="form-check-input" type="checkbox" name="receive_monthly_exited"
                                       value="true" @(mExit ? "checked" : "") />
                                <label class="form-check-label">Monthly Exited</label>
                            </div>
                            <div class="form-check form-check-inline me-3">
                                <input class="form-check-input" type="checkbox" name="receive_monthly_transactions"
                                       value="true" @(mTran ? "checked" : "") />
                                <label class="form-check-label">Monthly Transactions</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 text-end align-self-end mt-3 mt-md-0">
                        @if (ViewBag.CanWrite == true)
                        {
                            <button type="submit" class="btn btn-sm btn-primary">
                                @(isEdit ? "Update" : "Save")
                            </button>
                        }
                        <a asp-action="Index" asp-route-id="" class="btn btn-sm btn-secondary ms-1">
                            Clear / New
                        </a>

                        @if (ViewBag.Message != null)
                        {
                            <span class="ms-2 text-success fw-bold small">@ViewBag.Message</span>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header py-2">
            <strong>Sites List</strong>
        </div>
        <div class="card-body p-2">
            <div class="table-responsive">
                <table class="table table-sm table-bordered table-hover mb-0">
                    <thead class="table-dark">
                        <tr class="align-middle">
                            <th>#</th>
                            <th>Site</th>
                            <th>Client</th>
                            <th>Email</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>SID</th>
                            <th>Cust</th>
                            <th>Daily Ex</th>
                            <th>Daily Tx</th>
                            <th>Mon Ex</th>
                            <th>Mon Tx</th>
                            <th>Created On</th>
                            <th>Updated On</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="15" class="text-center text-muted small">No records found</td>
                            </tr>
                        }
                        else
                        {
                            var idx = 1;
                            foreach (var s in Model)
                            {
                                <tr class="align-middle small">
                                    <td>@idx</td>
                                    <td>@s.site_name</td>
                                    <td>@s.client_name</td>
                                    <td>@s.client_email</td>
                                    <td>@s.site_type</td>
                                    <td>@(s.client_status ? "Active" : "Inactive")</td>
                                    <td>@s.site_id</td>
                                    <td>@s.customer_id</td>
                                    <td class="text-center">@((s.receive_daily_exited) ? "✔" : "")</td>
                                    <td class="text-center">@((s.receive_daily_transactions) ? "✔" : "")</td>
                                    <td class="text-center">@((s.receive_monthly_exited) ? "✔" : "")</td>
                                    <td class="text-center">@((s.receive_monthly_transactions) ? "✔" : "")</td>
                                    <td>@s.created_on</td>
                                    <td>@s.updated_on</td>
                                    <td>
                                        <a asp-action="Index" asp-route-id="@s.id"
                                           class="btn btn-sm btn-primary @(ViewBag.CanWrite == true ? "" : "d-none")">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
