        /* Exit confirm */
        document.getElementById('btnConfirmExit').addEventListener('click', async function () {

            if (!pendingRemoveId) {
                alert('No overdue entry selected.');
                return;
            }

            var button = this;

            var exitInput = document.getElementById('exitTime');
            var chargeInput = document.getElementById('exitCharge');

            var exitTime = exitInput.value;
            var chargeText = chargeInput.value;

            if (!exitTime) {
                exitInput.classList.add('is-invalid');
                return;
            }

            if (!chargeText || isNaN(parseFloat(chargeText))) {
                chargeInput.classList.add('is-invalid');
                return;
            }

            var charge = parseFloat(chargeText);

            if (charge < 0) {
                chargeInput.classList.add('is-invalid');
                return;
            }

            exitInput.classList.remove('is-invalid');
            chargeInput.classList.remove('is-invalid');

            button.disabled = true;
            button.innerHTML =
                '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';

            try {

                var params = new URLSearchParams();

                params.append('id', pendingRemoveId);
                params.append('exitTime', exitTime);
                params.append('charge', charge.toFixed(2));

                var response = await fetch(
                    '/RealTimeReport/ExitOverdueTag?' + params.toString(),
                    {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': getAntiForgeryToken(),
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    }
                );

                var responseText = await response.text();

                var result;

                try {
                    result = JSON.parse(responseText);
                }
                catch (parseError) {
                    console.error(
                        'ExitOverdueTag returned non-JSON:',
                        responseText
                    );

                    throw new Error(
                        'Server returned an invalid response. HTTP ' +
                        response.status
                    );
                }

                if (!response.ok) {
                    throw new Error(
                        result.message ||
                        ('Exit request failed. HTTP ' + response.status)
                    );
                }

                if (!result.success) {

                    alert(
                        result.message ||
                        'Unable to exit vehicle.'
                    );

                    return;
                }

                var modalElement =
                    document.getElementById('exitModal');

                var modal =
                    bootstrap.Modal.getInstance(modalElement);

                if (modal) {
                    modal.hide();
                }

                alert(
                    'Vehicle exited successfully.\n\n' +
                    'Exit Charge: KES ' +
                    Number(charge).toFixed(2)
                );

                pendingRemoveId = null;

                await loadAllReports(false);

            }
            catch (error) {

                console.error(
                    'ExitOverdueTag error:',
                    error
                );

                alert(
                    error.message ||
                    'Unable to process vehicle exit.'
                );

            }
            finally {

                button.disabled = false;

                button.innerHTML =
                    '<i class="fas fa-sign-out-alt me-1"></i>Confirm Exit';
            }
        });


            /* Load B2 tab lazily on first click */
            document.getElementById('tab-b2').addEventListener('shown.bs.tab', function () {
                loadB2Tab();
            });

            /* Auto-refresh every 30 s */
            setInterval(function () {
                loadAllReports(true);
                if (document.getElementById('pane-b2').classList.contains('active')) {
                    loadB2Tab(true);
                }
            }, 30000);

            /* Live park-time ticker */
            setInterval(function () {
                document.querySelectorAll('.park-time-live').forEach(function (el) {
                    var entryStr = el.getAttribute('data-entry');
                    if (!entryStr) return;
                    var entry = new Date(entryStr);
                    if (isNaN(entry)) return;
                    var diff = Math.floor((new Date() - entry) / 1000);
                    if (diff < 0) diff = 0;
                    var hh = String(Math.floor(diff / 3600)).padStart(2, '0');
                    var mm = String(Math.floor((diff % 3600) / 60)).padStart(2, '0');
                    var ss = String(diff % 60).padStart(2, '0');
                    el.textContent = hh + ':' + mm + ':' + ss;
                });
            }, 1000);
        });

        /* ── Helpers ─────────────────────────────────────── */
        function matchesQuery(item, q) {
            if (!q) return true;
            return [item.cardno, item.card_name, item.car_plate_no, item.card_type,
                    item.entry_date, item.car_parkers_sub_co_name, item.fee_schedule_name,
                    item.pay_mode, item.mpesa_receipt_number, item.action_status, item.remark]
                .some(function (v) { return (v || '').toLowerCase().includes(q); });
        }
        function applySearch(data, q) {
            if (!q) return data;
            return data.filter(function (item) { return matchesQuery(item, q); });
        }
        function getFilteredData(data) {
            var filtered = (data || []).slice();
            if (selectedCardTypes.size > 0) {
                filtered = filtered.filter(function (x) { return selectedCardTypes.has((x.card_type || '').toString().trim()); });
            }
            return sortValidated(filtered);
        }
        function sortValidated(data) {
            if (validatedSortState === 'none') return data;
            return data.slice().sort(function (a, b) {
                var av = Number(a.isValidated) || 0;
                var bv = Number(b.isValidated) || 0;
                return validatedSortState === 'asc' ? av - bv : bv - av;
            });
        }
                function renderAllTables() { renderCurrentTable(); renderPastTable(); }

        function validatedLabel(v) {
            var n = (v === true) ? 1 : (Number(v) || 0);
            return n === 1  ? 'Validated'
                 : n === 10 ? 'Revalidation Required'
                 : n === 11 ? 'Revalidated'
                 : 'Not Validated';
        }
        function validatedBadge(v) {
            var n = (v === true) ? 1 : (Number(v) || 0);
            var cls = n === 1  ? 'bg-success'
                    : n === 10 ? 'bg-danger'
                    : n === 11 ? 'bg-primary'
                    : 'bg-secondary';
            return '<span class="badge ' + cls + '">' + validatedLabel(v) + '</span>';
        }

        /* ── Pagination ──────────────────────────────────── */
        function buildPagination(containerId, infoId, totalRecords, currentPg, onPageChange) {
            var totalPages = Math.max(1, Math.ceil(totalRecords / PAGE_SIZE));
            var start = totalRecords === 0 ? 0 : (currentPg - 1) * PAGE_SIZE + 1;
            var end   = Math.min(currentPg * PAGE_SIZE, totalRecords);
            document.getElementById(infoId).textContent =
                totalRecords === 0 ? 'No records found' : 'Showing ' + start + ' – ' + end + ' of ' + totalRecords + ' records';
            var ul = document.getElementById(containerId);
            ul.innerHTML = '';
            if (totalPages <= 1) return;
            function makeItem(label, page, disabled, active) {
                var li = document.createElement('li');
                li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
                var a = document.createElement('a');
                a.className = 'page-link'; a.href = '#'; a.innerHTML = label;
                if (!disabled && !active) {
                    a.addEventListener('click', function (e) { e.preventDefault(); onPageChange(page); });
                }
                li.appendChild(a); ul.appendChild(li);
            }
            makeItem('&laquo;', 1, currentPg === 1, false);
            makeItem('&lsaquo;', currentPg - 1, currentPg === 1, false);
            var startP = Math.max(1, currentPg - 2);
            var endP   = Math.min(totalPages, currentPg + 2);
            for (var p = startP; p <= endP; p++) makeItem(p, p, false, p === currentPg);
            makeItem('&rsaquo;', currentPg + 1, currentPg === totalPages, false);
            makeItem('&raquo;', totalPages, currentPg === totalPages, false);
        }

