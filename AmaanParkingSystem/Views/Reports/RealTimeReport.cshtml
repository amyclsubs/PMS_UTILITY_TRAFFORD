        // search handler
        document.addEventListener('input', function (e) {
            if (e.target && e.target.id === 'b2NotifiedSearch') {
                var q = e.target.value.toLowerCase();
                if (!b2NotifiedData) return;

                var filtered = b2NotifiedData.filter(function (c) {
                    var cardNo = (c.cardNo || '').toLowerCase();
                    var cardName = (c.cardName || '').toLowerCase();
                    var subCo = (c.subCompanyName || '').toLowerCase();
                    return cardNo.indexOf(q) >= 0 || cardName.indexOf(q) >= 0 || subCo.indexOf(q) >= 0;
                });

                if (filtered.length === 0) {
                    document.getElementById('b2NotifiedWrapper').innerHTML =
