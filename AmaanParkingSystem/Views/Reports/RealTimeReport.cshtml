        // CSV export
        function exportB2Notified() {
            if (!b2NotifiedData || b2NotifiedData.length === 0) {
                alert('No notified cards to export.');
                return;
            }

            var rows = [
                ['Card No', 'Card Name', 'Card Type', 'Sub Company', 'Email', 'Entry Time', 'Notification Time', 'Status']
            ];

            b2NotifiedData.forEach(function (c) {
                rows.push([
                    c.cardNo || '',
                    c.cardName || '',
                    c.cardType || '',
                    c.subCompanyName || '',
                    c.email || '',
                    c.entryTime || '',
                    c.notificationTime || '',
                    c.status || ''
                ]);
            });

            var csv = rows
                .map(function (r) {
                    return r.map(function (x) {
                        var v = (x || '').replace(/"/g, '""');
                        return '"' + v + '"';
                    }).join(',');
                })
                .join('\r\n');

            var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'B2_Notified_Cards.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

