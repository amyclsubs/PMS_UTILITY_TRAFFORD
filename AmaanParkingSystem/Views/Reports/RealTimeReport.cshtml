        function buildCardTypeCheckboxes() {
            ['cardTypeFilterList', 'cardTypeFilterList2'].forEach(function (id) {
                var container = document.getElementById(id);
                container.innerHTML = '';
                cardTypeOptions.forEach(function (ct) {
                    var div = document.createElement('div'); div.className = 'form-check';
                    var cb  = document.createElement('input');
                    cb.type = 'checkbox'; cb.className = 'form-check-input card-type-cb';
                    cb.value = ct; cb.id = id + '_' + ct; cb.checked = selectedCardTypes.has(ct);
                    cb.addEventListener('change', function () {
                        if (this.checked) selectedCardTypes.add(this.value); else selectedCardTypes.delete(this.value);
                        syncCheckboxes(this.value, this.checked); currentPage = 1; pastPage = 1; renderAllTables();
                    });
                    var lbl = document.createElement('label');
                    lbl.className = 'form-check-label'; lbl.htmlFor = cb.id; lbl.textContent = ct;
                    div.appendChild(cb); div.appendChild(lbl); container.appendChild(div);
                });
            });
        }
        function syncCheckboxes(value, checked) {
            document.querySelectorAll('.card-type-cb').forEach(function (cb) { if (cb.value === value) cb.checked = checked; });
        }
        function setupCardTypePopup() {
            document.addEventListener('click', function (e) {
                if (e.target.closest('.card-type-filter-toggle')) {
                    var popup = e.target.closest('th').querySelector('[id^="cardTypeFilterPopup"]');
                    document.querySelectorAll('[id^="cardTypeFilterPopup"]').forEach(function (p) { if (p !== popup) p.style.display = 'none'; });
                    popup.style.display = popup.style.display === 'none' ? 'block' : 'none';
                    e.stopPropagation(); return;
                }
                document.querySelectorAll('[id^="cardTypeFilterPopup"]').forEach(function (p) { p.style.display = 'none'; });
            });
            ['btnCardTypeSelectAll','btnCardTypeSelectAll2'].forEach(function (btnId) {
                var btn = document.getElementById(btnId);
                if (btn) btn.addEventListener('click', function () {
                    cardTypeOptions.forEach(function (ct) { selectedCardTypes.add(ct); });
                    buildCardTypeCheckboxes(); currentPage = 1; pastPage = 1; renderAllTables();
                });
            });
            ['btnCardTypeClear','btnCardTypeClear2'].forEach(function (btnId) {
                var btn = document.getElementById(btnId);
                if (btn) btn.addEventListener('click', function () {
                    selectedCardTypes.clear(); buildCardTypeCheckboxes(); currentPage = 1; pastPage = 1; renderAllTables();
                });
            });
        }
        function updateSortIcons() {
            document.querySelectorAll('.validated-sort').forEach(function (th) {
                var icon = th.querySelector('i');
                if (!icon) return;
                icon.className = validatedSortState === 'asc' ? 'fas fa-sort-up ms-1' : validatedSortState === 'desc' ? 'fas fa-sort-down ms-1' : 'fas fa-sort ms-1';
            });
        }

        /* ── Remove modal ────────────────────────────────── */
        function openRemoveModal(id) {
            var entry = pastData.find(function (x) { return x.id === id; });
            if (!entry) return;
            pendingRemoveId = Number(id);
            document.getElementById('removeEntryInfo').innerHTML =
                '<strong>Card:</strong> ' + esc(entry.cardno) + ' — ' + esc(entry.card_name) +
                '<br><strong>Plate:</strong> ' + esc(entry.car_plate_no) +
                '<br><strong>Entry:</strong> ' + esc(entry.entry_date) + ' ' + esc(entry.entry_time_only);
            document.getElementById('removeRemark').value = '';
            document.getElementById('removeRemark').classList.remove('is-invalid');
            new bootstrap.Modal(document.getElementById('removeModal')).show();
        }
        function openExitModal(id) {

            var item = pastData.find(function (x) {
                return x.id === id;
            });

            if (!item) return;

            pendingRemoveId = id;

            document.getElementById('exitEntryInfo').innerHTML =
                '<strong>Card Name:</strong> ' + esc(item.card_name || '—') +
                '<br><strong>Plate:</strong> ' + esc(item.car_plate_no || '—') +
                '<br><strong>Card Type:</strong> ' + esc(item.card_type || '—') +
                '<br><strong>Entry:</strong> ' +
                esc(item.entry_date || '') + ' ' +
                esc(item.entry_time_only || '');

            // Set current local date/time as default
            var now = new Date();

            var localDateTime =
                now.getFullYear() + '-' +
                String(now.getMonth() + 1).padStart(2, '0') + '-' +
                String(now.getDate()).padStart(2, '0') + 'T' +
                String(now.getHours()).padStart(2, '0') + ':' +
                String(now.getMinutes()).padStart(2, '0');

        var exitInput = document.getElementById('exitTime');
        var chargeInput = document.getElementById('exitCharge');

        exitInput.value = localDateTime;
        exitInput.classList.remove('is-invalid');

        chargeInput.value = '';
        chargeInput.classList.remove('is-invalid');

        var modal = new bootstrap.Modal(
            document.getElementById('exitModal')
        );

        modal.show();

        }

        function doRemoveEntry(id, remark) {
            if (!remark || !remark.trim()) { document.getElementById('removeRemark').classList.add('is-invalid'); return; }
            var params = new URLSearchParams({ id: id, remark: remark.trim() });
            fetch('/RealTimeReport/RemoveOverdueEntry?' + params.toString(), {
                method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() }
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    bootstrap.Modal.getInstance(document.getElementById('removeModal')).hide();
                    if (res.success) loadAllReports(false);
                    else alert('Error: ' + res.message);
                })
                .catch(function (err) { alert('AJAX error: ' + err.message); });
        }
                /* ══════════════════════════════════════════════════
           DELETED CARDS TAB JS
           ══════════════════════════════════════════════════ */
        var deletedData = [];
        var deletedPage = 1;

        (function initDeletedTab() {

            // Set default date range to today on page load
            var todayStr = getTodayStr();
            document.getElementById('deletedFrom').value = todayStr;
            document.getElementById('deletedTo').value   = todayStr;

            // Quick-range buttons
            document.querySelectorAll('.deleted-quick').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var range = this.getAttribute('data-range');
                    var now   = new Date();

                    document.querySelectorAll('.deleted-quick').forEach(function (b) { b.classList.remove('btn-secondary'); b.classList.add('btn-outline-secondary'); });
                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('btn-secondary');

                    if (range === 'today') {
                        document.getElementById('deletedFrom').value = fmtDate(now);
                        document.getElementById('deletedTo').value   = fmtDate(now);
                    } else if (range === 'yesterday') {
                        var y = new Date(now); y.setDate(y.getDate() - 1);
                        document.getElementById('deletedFrom').value = fmtDate(y);
                        document.getElementById('deletedTo').value   = fmtDate(y);
                    } else if (range === 'week') {
                        // Mon–Sun of current week
                        var day  = now.getDay(); // 0=Sun
                        var diff = (day === 0) ? -6 : 1 - day; // shift to Monday
                        var mon  = new Date(now); mon.setDate(now.getDate() + diff);
                        var sun  = new Date(mon); sun.setDate(mon.getDate() + 6);
                        document.getElementById('deletedFrom').value = fmtDate(mon);
                        document.getElementById('deletedTo').value   = fmtDate(sun);
                    } else if (range === 'month') {
                        // 1st to last day of current month
                        var first = new Date(now.getFullYear(), now.getMonth(), 1);
                        var last  = new Date(now.getFullYear(), now.getMonth() + 1, 0);
                        document.getElementById('deletedFrom').value = fmtDate(first);
                        document.getElementById('deletedTo').value   = fmtDate(last);
                    }
                    loadDeletedCards();
                });
            });

            // Search button
            document.getElementById('btnDeletedSearch').addEventListener('click', function () {
                deletedPage = 1;
                loadDeletedCards();
            });

            // Clear button — reset to today
            document.getElementById('btnDeletedClear').addEventListener('click', function () {
                var todayStr = getTodayStr();
                document.getElementById('deletedFrom').value = todayStr;
                document.getElementById('deletedTo').value   = todayStr;
                document.querySelectorAll('.deleted-quick').forEach(function (b) { b.classList.remove('btn-secondary'); b.classList.add('btn-outline-secondary'); });
                deletedData = []; deletedPage = 1;
                setEmpty('tblDeletedBody', 15, 'Select a date range and click Search.');
                document.getElementById('deletedBadge').textContent = 0;
                document.getElementById('deletedTableBadge').textContent = 0;
                buildPagination('deletedPagination', 'deletedPageInfo', 0, 1, function(){});
            });

            // Export
            document.getElementById('btnExportDeleted').addEventListener('click', function () {
                exportToCSV(deletedData, 'Deleted_Cards_' + getTodayStr());
            });

            // Load on tab click (lazy first load)
            document.getElementById('tab-deleted').addEventListener('shown.bs.tab', function () {
                if (deletedData.length === 0) loadDeletedCards();
            });

        })();

        function fmtDate(d) {
            return d.getFullYear() + '-' +
                   String(d.getMonth() + 1).padStart(2, '0') + '-' +
                   String(d.getDate()).padStart(2, '0');
        }

        function loadDeletedCards() {
            var from = document.getElementById('deletedFrom').value;
            var to   = document.getElementById('deletedTo').value;

            if (!from || !to) { alert('Please select both From and To dates.'); return; }
            if (from > to)    { alert('From date cannot be after To date.'); return; }

            setLoading('tblDeletedBody', 15, 'Loading deleted cards...');

            fetch('/RealTimeReport/GetDeletedCards?fromDate=' + encodeURIComponent(from) + '&toDate=' + encodeURIComponent(to))
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    document.getElementById('deletedBadge').textContent      = res.count || 0;
                    document.getElementById('deletedTableBadge').textContent = res.count || 0;

                    if (!res.success) {
                        setError('tblDeletedBody', 15, res.message || 'Failed to load.');
                        return;
                    }
                    deletedData = res.data || [];
                    deletedPage = 1;
                    renderDeletedTable();
                })
                .catch(function (err) { setError('tblDeletedBody', 15, 'AJAX error: ' + err.message); });
        }

        function renderDeletedTable() {
            if (deletedData.length === 0) {
                setEmpty('tblDeletedBody', 15, 'No deleted cards found for the selected period.');
                buildPagination('deletedPagination', 'deletedPageInfo', 0, 1, function(){});
                return;
            }
            var totalPages = Math.ceil(deletedData.length / PAGE_SIZE);
            if (deletedPage > totalPages) deletedPage = totalPages;
            var pageData = deletedData.slice((deletedPage - 1) * PAGE_SIZE, deletedPage * PAGE_SIZE);
            var html = '';
            pageData.forEach(function (item, idx) {
                var globalIdx = (deletedPage - 1) * PAGE_SIZE + idx + 1;
                html += '<tr>' +
                    '<td>' + globalIdx + '</td>' +
                    '<td>' + esc(item.cardno) + '</td>' +
                    '<td>' + esc(item.card_name) + '</td>' +
                    '<td><strong>' + esc(item.car_plate_no) + '</strong></td>' +
                    '<td>' + esc(item.card_type) + '</td>' +
                    '<td>' + esc(item.entry_time) + '</td>' +
                    '<td>' + esc(item.fee_schedule_name) + '</td>' +
                    '<td>' + esc(item.car_parkers_sub_co_name) + '</td>' +
                    '<td class="text-end">' + fmtCurrency(item.display_charges) + '</td>' +
                    '<td>' + esc(item.pay_mode) + '</td>' +
                    '<td>' + esc(item.mpesa_receipt_number) + '</td>' +
                    '<td>' + validatedBadge(item.isValidated) + '</td>' +
                    '<td>' + esc(item.remark) + '</td>' +
                    '<td class="text-danger fw-semibold">' + esc(item.removed_at) + '</td>' +
                    '<td>' + esc(item.removed_by) + '</td>' +
                    '</tr>';
            });
            document.getElementById('tblDeletedBody').innerHTML = html;
            buildPagination('deletedPagination', 'deletedPageInfo', deletedData.length, deletedPage, function (pg) {
                deletedPage = pg;
                renderDeletedTable();
                var w = document.querySelector('#tblDeletedCards').closest('.table-scroll-wrapper');
                if (w) w.scrollTop = 0;
            });
        }

        /* ── Tiny utilities ──────────────────────────────── */
        function esc(v) {
            if (v === null || v === undefined) return '—';
            return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
        function fmtCurrency(v) {
            if (v === null || v === undefined) return '—';
            return parseFloat(v).toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function getTodayStr() {
            var d = new Date();
            return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
        }
        function getAntiForgeryToken() {
            var el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
        function setLoading(tbodyId, colspan, msg) {
            document.getElementById(tbodyId).innerHTML =
                '<tr><td colspan="' + colspan + '" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-2"></i>' + msg + '</td></tr>';
        }
        function setEmpty(tbodyId, colspan, msg) {
            document.getElementById(tbodyId).innerHTML =
                '<tr><td colspan="' + colspan + '" class="text-center text-muted py-3">' + msg + '</td></tr>';
        }
        function setError(tbodyId, colspan, msg) {
            document.getElementById(tbodyId).innerHTML =
                '<tr><td colspan="' + colspan + '" class="text-center text-danger py-3"><i class="fas fa-exclamation-triangle me-1"></i>' + msg + '</td></tr>';
        }
        function exportToCSV(data, filename) {
            if (!data || data.length === 0) { alert('No data to export.'); return; }
            var keys = Object.keys(data[0]);
            var csv  = keys.join(',') + '\n';
            data.forEach(function (row) {
                csv += keys.map(function (k) {
                            var v = row[k] === null || row[k] === undefined ? '' : String(row[k]);
        if (k === 'isValidated') v = validatedLabel(row[k]);
                    return '"' + v.replace(/"/g, '""') + '"';
                }).join(',') + '\n';
            });
            var blob = new Blob([csv], { type: 'text/csv' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob); a.download = filename + '.csv'; a.click();
        }
    </script>
}
