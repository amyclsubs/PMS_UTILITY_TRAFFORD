@{
    ViewData["Title"] = "Real Time Report";
    var canWriteJs = (ViewBag.CanWrite == true) ? "true" : "false";
}
<script>
    var canWrite = @Html.Raw(canWriteJs);
</script>

<!-- ── Page Header ─────────────────────────────────────────────── -->
<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2><i class="fas fa-chart-line me-2"></i>Real Time Parking Report</h2>
        <p class="text-muted mb-0">Live view of vehicles currently parked. Auto-refreshes every 30 seconds.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small">Last refreshed: <span id="lastRefreshed">-</span></span>
        <button type="button" class="btn btn-primary btn-sm" id="btnReloadAll">
            <i class="fas fa-rotate-right me-1"></i>Refresh Now
        </button>
    </div>
</div>

<!-- ── Tab Navigation ──────────────────────────────────────────── -->
<ul class="nav nav-tabs mb-0 border-bottom-0" id="rtrTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-realtime" data-bs-toggle="tab"
                data-bs-target="#pane-realtime" type="button" role="tab"
                aria-controls="pane-realtime" aria-selected="true">
            <i class="fas fa-chart-line me-1 text-success"></i>
            Real Time Report
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-b2" data-bs-toggle="tab"
                data-bs-target="#pane-b2" type="button" role="tab"
                aria-controls="pane-b2" aria-selected="false">
            <i class="fas fa-parking me-1 text-warning"></i>
            B2 Pending
            <span class="badge bg-warning text-dark ms-1" id="b2Badge">0</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-deleted" data-bs-toggle="tab"
                data-bs-target="#pane-deleted" type="button" role="tab"
                aria-controls="pane-deleted" aria-selected="false">
            <i class="fas fa-trash-alt me-1 text-danger"></i>
            Deleted Cards
            <span class="badge bg-danger ms-1" id="deletedBadge">0</span>
        </button>
    </li>
</ul>


<!-- ── Tab Content ─────────────────────────────────────────────── -->
<div class="tab-content border border-top-0 rounded-bottom mb-4" id="rtrTabContent">

    <!-- ════════════ TAB 1 – REAL TIME REPORT (Today + Overdue) ═══ -->
    <div class="tab-pane fade show active p-0" id="pane-realtime" role="tabpanel" aria-labelledby="tab-realtime">

        <!-- TODAY'S PARKED -->
        <div class="card border-0 mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h5 class="mb-0">
                        <i class="fas fa-car me-2 text-success"></i>
                        Today's Parked Vehicles
                        <span class="badge bg-success ms-2" id="currentBadge">0</span>
                    </h5>
                    <div class="input-group input-group-sm" style="min-width:200px; max-width:280px;">
                        <input type="text" class="form-control" id="currentSearchInput" placeholder="Search today's vehicles...">
                        <button class="btn btn-success" type="button" id="btnCurrentSearch" title="Search">
                            <i class="fas fa-search"></i>
                        </button>
                        <button class="btn btn-danger" type="button" id="btnCurrentClear" title="Clear">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                <button type="button" class="btn btn-success fw-bold" id="btnExportCurrent">
                    <i class="fas fa-file-csv me-1"></i>Export to CSV
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-scroll-wrapper">
                    <table class="table table-bordered table-hover table-sm mb-0 table-sticky-head" id="tblCurrentEntries">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Card No</th>
                                <th>Card Name</th>
                                <th>Plate No</th>
                                <th>
                                    <div class="d-flex align-items-center justify-content-between gap-1 position-relative">
                                        <span>Card Type</span>
                                        <button type="button" class="btn btn-link btn-sm text-white p-0 card-type-filter-toggle" title="Filter Card Type">
                                            <i class="fas fa-filter"></i>
                                        </button>
                                    </div>
                                    <div id="cardTypeFilterPopup" class="card shadow position-absolute p-2 bg-white text-dark" style="display:none; top:100%; left:0; z-index:1050; min-width:240px; max-height:280px; overflow:auto;">
                                        <div class="fw-bold mb-2">Filter Card Type</div>
                                        <div class="mb-2 d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnCardTypeSelectAll">All</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCardTypeClear">Clear</button>
                                        </div>
                                        <div id="cardTypeFilterList"></div>
                                    </div>
                                </th>
                                <th>Entry Date</th>
                                <th>Entry Time</th>
                                <th>Live Park Time</th>
                                <th>Fee Schedule</th>
                                <th>Company</th>
                                <th>Charges (KES)</th>
                                <th>Action Status</th>
                                <th class="validated-sort" data-sort="none" style="cursor:pointer; user-select:none;">Validated <i class="fas fa-sort ms-1"></i></th>
                                <th>Pay Mode</th>
                                <th>M-Pesa Ref</th>
                                <th>Remark</th>
                            </tr>
                        </thead>
                        <tbody id="tblCurrentBody">
                            <tr><td colspan="16" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-2"></i>Loading today's entries...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 px-3 py-2 border-top" id="currentPaginationBar">
                    <div class="text-muted small" id="currentPageInfo">Showing 0 records</div>
                    <nav aria-label="Current entries pagination">
                        <ul class="pagination pagination-sm mb-0" id="currentPagination"></ul>
                    </nav>
                </div>
            </div>
        </div>

        <!-- OVERDUE VEHICLES -->
        <div class="card border-0 mb-0">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h5 class="mb-0">
                        <i class="fas fa-clock-rotate-left me-2 text-danger"></i>
                        Overdue Vehicles (Entered Before Today &ndash; Still Parked)
                        <span class="badge bg-danger ms-2" id="pastBadge">0</span>
                    </h5>
                    <div class="input-group input-group-sm" style="min-width:200px; max-width:280px;">
                        <input type="text" class="form-control" id="pastSearchInput" placeholder="Search overdue vehicles...">
                        <button class="btn btn-success" type="button" id="btnPastSearch" title="Search">
                            <i class="fas fa-search"></i>
                        </button>
                        <button class="btn btn-danger" type="button" id="btnPastClear" title="Clear">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                <button type="button" class="btn btn-danger fw-bold" id="btnExportPast">
                    <i class="fas fa-file-csv me-1"></i>Export to CSV
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-scroll-wrapper">
                    <table class="table table-bordered table-hover table-sm mb-0 table-sticky-head" id="tblPastEntries">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Card No</th>
                                <th>Card Name</th>
                                <th>Plate No</th>
                                <th>
                                    <div class="d-flex align-items-center justify-content-between gap-1 position-relative">
                                        <span>Card Type</span>
                                        <button type="button" class="btn btn-link btn-sm text-white p-0 card-type-filter-toggle" title="Filter Card Type">
                                            <i class="fas fa-filter"></i>
                                        </button>
                                    </div>
                                    <div id="cardTypeFilterPopup2" class="card shadow position-absolute p-2 bg-white text-dark" style="display:none; top:100%; left:0; z-index:1050; min-width:240px; max-height:280px; overflow:auto;">
                                        <div class="fw-bold mb-2">Filter Card Type</div>
                                        <div class="mb-2 d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnCardTypeSelectAll2">All</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCardTypeClear2">Clear</button>
                                        </div>
                                        <div id="cardTypeFilterList2"></div>
                                    </div>
                                </th>
                                <th>Entry Date</th>
                                <th>Entry Time</th>
                                <th>Total Park Time</th>
                                <th>Fee Schedule</th>
                                <th>Company</th>
                                <th>Charges (KES)</th>
                                <th>Action Status</th>
                                <th class="validated-sort" data-sort="none" style="cursor:pointer; user-select:none;">Validated <i class="fas fa-sort ms-1"></i></th>
                                <th>Pay Mode</th>
                                <th>M-Pesa Ref</th>
                                <th>Remark</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="tblPastBody">
                            <tr><td colspan="17" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-2"></i>Loading overdue entries...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 px-3 py-2 border-top" id="pastPaginationBar">
                    <div class="text-muted small" id="pastPageInfo">Showing 0 records</div>
                    <nav aria-label="Past entries pagination">
                        <ul class="pagination pagination-sm mb-0" id="pastPagination"></ul>
                    </nav>
                </div>
            </div>
        </div>

    </div><!-- /pane-realtime -->
    <!-- ════════════ TAB 2 – B2 PENDING (VIEW-ONLY) ═══════════════ -->
    <div class="tab-pane fade p-3" id="pane-b2" role="tabpanel" aria-labelledby="tab-b2">

        <!-- Info bar -->
        <div class="row g-2 mb-3">
            <div class="col-sm-6 col-lg-3">
                <div class="border rounded p-2 bg-light text-center">
                    <div class="text-muted" style="font-size:11px;">SERVICE STATUS</div>
                    <div id="b2ServiceStatus" class="fw-bold" style="font-size:13px;">—</div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="border rounded p-2 bg-light text-center">
                    <div class="text-muted" style="font-size:11px;">LAST RUN</div>
                    <div id="b2LastRun" class="fw-semibold" style="font-size:13px;">—</div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="border rounded p-2 bg-light text-center">
                    <div class="text-muted" style="font-size:11px;">NEXT RUN</div>
                    <div id="b2NextRun" class="fw-semibold" style="font-size:13px;">—</div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="border rounded p-2 bg-light text-center">
                    <div class="text-muted" style="font-size:11px;">EMAILS SENT / FAILED</div>
                    <div class="fw-semibold" style="font-size:13px;">
                        <span class="text-success" id="b2EmailsSent">0</span>
                        /
                        <span class="text-danger" id="b2EmailsFailed">0</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Pending Cars Table -->
            <div class="col-lg-8">
                <div class="card border mb-0 h-100">
                    <div class="card-header d-flex justify-content-between align-items-center py-2">
                        <h6 class="mb-0 fw-bold">
                            <i class="fas fa-car me-1 text-warning"></i>
                            Pending B2 Cars
                            <span class="badge bg-warning text-dark ms-1" id="b2PendingBadge">0</span>
                        </h6>
                        <small class="text-muted">DAILY_ACCESS &amp; SEASONAL — no B2 entry yet, parked ≥ threshold</small>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-scroll-wrapper">
                            <table class="table table-bordered table-hover table-sm mb-0" id="tblB2Pending">
                                <thead style="background:#1a3c5e; color:#fff; position:sticky; top:0; z-index:2;">
                                    <tr>
                                        <th>#</th>
                                        <th>Card No</th>
                                        <th>Card Name</th>
                                        <th>Plate No</th>
                                        <th>Card Type</th>
                                        <th>Sub Company</th>
                                        <th>Entry Time</th>
                                        <th>Time Parked</th>
                                        <th>Fee Schedule</th>
                                    </tr>
                                </thead>
                                <tbody id="tblB2PendingBody">
                                    <tr><td colspan="9" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notified Cards (read-only) -->
            <div class="col-lg-4">
                <div class="card border mb-0 h-100">
                    <div class="card-header py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-bold">
                                    <i class="fas fa-envelope-open-text me-1 text-primary"></i> Notified Cards
                                </h6>
                                <small class="text-muted d-block mt-1" style="font-size:11px;">
                                    Cards below have already received an email for their current entry.
                                </small>
                            </div>
                            <div class="d-flex gap-2">
                                <input type="text"
                                       id="b2NotifiedSearch"
                                       class="form-control form-control-sm"
                                       placeholder="Search card / name" />
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        onclick="exportB2Notified()">
                                    <i class="fas fa-file-csv"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-2">
                        <div id="b2NotifiedWrapper" style="max-height:340px; overflow-y:auto;">
                            <div class="text-center text-muted py-3" style="font-size:13px;">No cards notified yet</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /pane-b2 -->
    <!-- ════════════ TAB 3 – DELETED CARDS ════════════════════════ -->
    <div class="tab-pane fade p-3" id="pane-deleted" role="tabpanel" aria-labelledby="tab-deleted">

        <!-- Date range filter bar -->
        <div class="card border-0 bg-light mb-3">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <strong class="me-1" style="font-size:13px;">Filter by Removed Date:</strong>

                    <!-- Quick buttons -->
                    <button type="button" class="btn btn-sm btn-outline-secondary deleted-quick" data-range="today">Today</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary deleted-quick" data-range="yesterday">Yesterday</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary deleted-quick" data-range="week">This Week</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary deleted-quick" data-range="month">This Month</button>

                    <div class="vr mx-1"></div>

                    <!-- Custom range -->
                    <label class="form-label mb-0" style="font-size:13px;">From</label>
                    <input type="date" id="deletedFrom" class="form-control form-control-sm" style="width:145px;">
                    <label class="form-label mb-0" style="font-size:13px;">To</label>
                    <input type="date" id="deletedTo" class="form-control form-control-sm" style="width:145px;">
                    <button type="button" class="btn btn-sm btn-primary" id="btnDeletedSearch">
                        <i class="fas fa-search me-1"></i>Search
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnDeletedClear">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="card border mb-0">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-trash-alt me-1 text-danger"></i>
                    Deleted / Archived Cards
                    <span class="badge bg-danger ms-1" id="deletedTableBadge">0</span>
                </h6>
                <button type="button" class="btn btn-danger fw-bold btn-sm" id="btnExportDeleted">
                    <i class="fas fa-file-csv me-1"></i>Export to CSV
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-scroll-wrapper">
                    <table class="table table-bordered table-hover table-sm mb-0 table-sticky-head" id="tblDeletedCards">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Card No</th>
                                <th>Card Name</th>
                                <th>Plate No</th>
                                <th>Card Type</th>
                                <th>Entry Time</th>
                                <th>Fee Schedule</th>
                                <th>Company</th>
                                <th>Charges (KES)</th>
                                <th>Pay Mode</th>
                                <th>M-Pesa Ref</th>
                                <th>Validated</th>
                                <th>Remark</th>
                                <th>Removed At</th>
                                <th>Removed By</th>
                            </tr>
                        </thead>
                        <tbody id="tblDeletedBody">
                            <tr><td colspan="15" class="text-center text-muted py-3">Select a date range and click Search.</td></tr>
                        </tbody>
                    </table>
                </div>
                <!-- Pagination -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 px-3 py-2 border-top" id="deletedPaginationBar">
                    <div class="text-muted small" id="deletedPageInfo">Showing 0 records</div>
                    <nav aria-label="Deleted cards pagination">
                        <ul class="pagination pagination-sm mb-0" id="deletedPagination"></ul>
                    </nav>
                </div>
            </div>
        </div>

    </div><!-- /pane-deleted -->

</div><!-- /tab-content -->
<!-- ── Remove Modal ────────────────────────────────── -->
<div class="modal fade" id="removeModal" tabindex="-1" aria-labelledby="removeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="removeModalLabel">
                    <i class="fas fa-trash-alt me-2"></i>Remove Overdue Entry
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p class="mb-2">
                    You are about to <strong>permanently remove</strong> this entry from the parking table and archive it.
                </p>

                <div id="removeEntryInfo"
                     class="alert alert-warning py-2 small mb-3"></div>

                <div class="mb-3">
                    <label for="removeRemark" class="form-label fw-semibold">
                        Remark <span class="text-danger">*</span>
                        <small class="text-muted fw-normal">(required)</small>
                    </label>

                    <textarea class="form-control"
                              id="removeRemark"
                              rows="2"
                              placeholder="e.g. Card lost, vehicle towed, manual clearance..."
                              required></textarea>

                    <div class="invalid-feedback" id="remarkError">
                        Remark is required. Please enter a reason for removing this entry.
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger overdue-action-btn"
                        id="btnConfirmRemove">
                    <i class="fas fa-trash-alt me-1"></i>Confirm Remove
                </button>
            </div>

        </div>
    </div>
</div>


<!-- ── Exit Overdue Vehicle Modal ───────────────────────────── -->
<div class="modal fade" id="exitModal" tabindex="-1" aria-labelledby="exitModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="exitModalLabel">
                    <i class="fas fa-sign-out-alt me-2"></i>Exit Overdue Vehicle
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <p class="mb-2">
                    Please enter the actual exit time for this overdue vehicle.
                </p>

                <div id="exitEntryInfo"
                     class="alert alert-warning py-2 small mb-3"></div>

                <div class="mb-3">
                    <label for="exitTime" class="form-label fw-semibold">
                        Exit Time <span class="text-danger">*</span>
                    </label>

                    <input type="datetime-local"
                           class="form-control"
                           id="exitTime"
                           required>

                    <div class="invalid-feedback">
                        Exit time is required.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="exitCharge" class="form-label fw-semibold">
                        Exit Charge (KES) <span class="text-danger">*</span>
                    </label>

                    <input type="number"
                           class="form-control"
                           id="exitCharge"
                           min="0"
                           step="0.01"
                           placeholder="Enter charge amount"
                           required>

                    <div class="invalid-feedback">
                        Please enter the exit charge.
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-success overdue-action-btn"
                        id="btnConfirmExit">
                    <i class="fas fa-sign-out-alt me-1"></i>Confirm Exit
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <style>
        .overdue-action-btn {
            width: 88px;
            min-width: 88px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .table-scroll-wrapper {
            overflow-x: auto;
            overflow-y: auto;
            max-height: 600px;
            position: relative;
        }

        .table-sticky-head thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background-color: #212529;
        }

        #currentPaginationBar,
        #pastPaginationBar {
            background: #f8f9fa;
            min-height: 44px;
        }

        .minutes-badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }

        .minutes-high {
            background: #f8d7da;
            color: #721c24;
        }

        .minutes-medium {
            background: #fff3cd;
            color: #856404;
        }

        .minutes-low {
            background: #d4edda;
            color: #155724;
        }

        #rtrTabContent {
            border-top: 1px solid #dee2e6;
        }
    </style>

    <script>
        var currentData        = [];
        var pastData           = [];
        var cardTypeOptions    = [];
        var selectedCardTypes  = new Set();
        var validatedSortState = 'none';
        var currentSearchQuery = '';
        var pastSearchQuery    = '';
        var pendingRemoveId    = null;

        var PAGE_SIZE   = 50;
        var currentPage = 1;
        var pastPage    = 1;

        document.addEventListener('DOMContentLoaded', function () {
            loadAllReports();
            loadCardTypes();
