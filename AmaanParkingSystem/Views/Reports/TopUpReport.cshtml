    <script>
        let startDatePicker, endDatePicker;
        let tagNoTimeout;
        let tempSelectedPaymentMode = null;

        document.addEventListener('DOMContentLoaded', function () {
            initializeDatePickers();
            loadSubCompanies();
            loadPaymentSources();
            setDefaultDates();
            loadCompaniesForCompanyTopUp();

            const subCompanyInput = document.getElementById('subCompanyInput');
            const hiddenSubCompany = document.getElementById('subCompany');

            subCompanyInput.addEventListener('change', function () {
                const val = this.value;
                const options = document.getElementById('subCompanyList').options;
                let matchedId = '';

                for (let i = 0; i < options.length; i++) {
                    if (options[i].value === val) {
                        matchedId = options[i].getAttribute('data-id') || '';
                        break;
                    }
                }

                hiddenSubCompany.value = matchedId;
            });

            document.getElementById('thisMonthBtn').addEventListener('click', setThisMonth);
            document.getElementById('lastMonthBtn').addEventListener('click', setLastMonth);
            document.getElementById('thisYearBtn').addEventListener('click', setThisYear);
            document.getElementById('lastYearBtn').addEventListener('click', setLastYear);

            // Company TOP-UP event handlers
            const companySelect = document.getElementById('ct_subCompanyId');
            const tagNoInput = document.getElementById('ct_tagNo');
            const topUpAmountInput = document.getElementById('ct_topUpAmount');

            if (companySelect) {
                companySelect.addEventListener('change', loadCompanyDetailsForTopUp);
            }

            if (tagNoInput) {
                tagNoInput.addEventListener('input', function() {
                    clearTimeout(tagNoTimeout);
                    tagNoTimeout = setTimeout(() => {
                        loadCompanyDetailsByTagNo();
                    }, 800);
                });
            }

            if (topUpAmountInput) {
                topUpAmountInput.addEventListener('input', calculateFinalBalanceTopUp);
            }

         // Payment mode confirmation on click
        const paymentModeRadios = document.querySelectorAll('input[name="ct_paymentMode"]');
        paymentModeRadios.forEach(radio => {
            radio.addEventListener('change', function() {
                const selectedMode = this.value;

                // Show confirmation immediately when value changes
                       showConfirm(`Are you sure you want to select "<strong>${selectedMode}</strong>" as the payment mode?`, () => {
            tempSelectedPaymentMode = selectedMode;
        });

        // If user cancels or clicks outside, uncheck
        const modalElement = document.getElementById('confirmModal');
        modalElement.addEventListener('hidden.bs.modal', function onHidden() {
            if (tempSelectedPaymentMode !== selectedMode) {
                radio.checked = false;
            }
            modalElement.removeEventListener('hidden.bs.modal', onHidden);
        });

            });
        });

            // Waiver modal event handlers
            setTimeout(function() {
                const companySelect = document.getElementById('wvr_subCompanyId');
                if (companySelect) {
                    companySelect.addEventListener('change', loadCompanyDetailsForWaiver);
                }

                const topUpInput = document.getElementById('wvr_topUpAmount');
                if (topUpInput) {
                    topUpInput.addEventListener('input', calculateFinalBalance);
                }
            }, 500);
        });
                var closeTrackingBtn = document.getElementById('closeTrackingBtn');
        if (closeTrackingBtn) {
            closeTrackingBtn.addEventListener('click', function() {
                var modalElement = document.getElementById('paymentTrackingModal');
                if (modalElement) {
                    var modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) {
                        modal.hide();
                    }
                }
            });
        }
        function initializeDatePickers() {
            startDatePicker = flatpickr("#startDate", {
                dateFormat: "d-M-Y",
                onChange: function (selectedDates) {
                    if (selectedDates.length > 0) {
                        const date = selectedDates[0];
                        const year = date.getFullYear();
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const day = String(date.getDate()).padStart(2, '0');
                        document.getElementById('startDateHidden').value = `${year}-${month}-${day}`;
                    }
                }
            });

            endDatePicker = flatpickr("#endDate", {
                dateFormat: "d-M-Y",
                onChange: function (selectedDates) {
                    if (selectedDates.length > 0) {
                        const date = selectedDates[0];
                        const year = date.getFullYear();
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const day = String(date.getDate()).padStart(2, '0');
                        document.getElementById('endDateHidden').value = `${year}-${month}-${day}`;
                    }
                }
            });
        }

        function setDefaultDates() {
            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            startDatePicker.setDate(firstDay);
            endDatePicker.setDate(today);
        }

        function setThisMonth() {
            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            startDatePicker.setDate(firstDay, true);
            endDatePicker.setDate(today, true);
            loadTopUpReport();
        }

        function setLastMonth() {
            const today = new Date();
            const firstDayLastMonth = new Date(today.getFullYear(), today.getMonth() - 1, 1);
            const lastDayLastMonth = new Date(today.getFullYear(), today.getMonth(), 0);
            startDatePicker.setDate(firstDayLastMonth, true);
            endDatePicker.setDate(lastDayLastMonth, true);
            loadTopUpReport();
        }

        function setThisYear() {
            const today = new Date();
            const firstDayYear = new Date(today.getFullYear(), 0, 1);
            startDatePicker.setDate(firstDayYear, true);
            endDatePicker.setDate(today, true);
            loadTopUpReport();
        }

        function setLastYear() {
            const today = new Date();
            const lastYear = today.getFullYear() - 1;
            const firstDayLastYear = new Date(lastYear, 0, 1);
            const lastDayLastYear = new Date(lastYear, 11, 31);
            startDatePicker.setDate(firstDayLastYear, true);
            endDatePicker.setDate(lastDayLastYear, true);
            loadTopUpReport();
        }

        function formatDateOnly(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            const day = String(date.getDate()).padStart(2, '0');
            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            const month = months[date.getMonth()];
            const year = date.getFullYear();
            return `${day}-${month}-${year}`;
        }

        async function loadSubCompanies() {
            try {
                const response = await fetch('/TopUpReport/GetSubCompanies');
                const result = await response.json();

                if (result.success) {
                    const dataList = document.getElementById('subCompanyList');
                    dataList.innerHTML = '';

                    const emptyOption = document.createElement('option');
                    emptyOption.value = '';
                    emptyOption.textContent = 'All Companies';
                    dataList.appendChild(emptyOption);

                    result.data.forEach(company => {
                        const option = document.createElement('option');
                        option.value = `${company.car_parkers_sub_co_id} - ${company.car_parkers_sub_co_name}`;
                        option.setAttribute('data-id', company.car_parkers_sub_co_id);
                        dataList.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Error loading sub companies:', error);
            }
        }

        async function loadPaymentSources() {
            try {
                const response = await fetch('/TopUpReport/GetPaymentSources');
                const result = await response.json();

                if (result.success) {
                    const list = document.getElementById('paymentSourceList');

                    result.data.forEach(source => {
                        const li = document.createElement('li');
                        const div = document.createElement('div');
                        div.className = 'form-check';

                        const checkbox = document.createElement('input');
                        checkbox.className = 'form-check-input payment-source-checkbox';
                        checkbox.type = 'checkbox';
                        checkbox.value = source.payment_source;
                        checkbox.id = 'source_' + source.payment_source.replace(/[^a-zA-Z0-9]/g, '_');

                        const label = document.createElement('label');
                        label.className = 'form-check-label';
                        label.htmlFor = checkbox.id;
                        label.textContent = source.payment_source;

                        div.appendChild(checkbox);
                        div.appendChild(label);
                        li.appendChild(div);
                        list.appendChild(li);
                    });

                    setupPaymentSourceCheckboxes();
                }
            } catch (error) {
                console.error('Error loading payment sources:', error);
            }
        }

        function setupPaymentSourceCheckboxes() {
            const allCheckbox = document.getElementById('sourceAll');
            const otherCheckboxes = document.querySelectorAll('.payment-source-checkbox:not(#sourceAll)');
            const label = document.getElementById('selectedSourcesLabel');

            allCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    otherCheckboxes.forEach(cb => cb.checked = false);
                    label.textContent = 'All Sources';
                }
            });

            otherCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        allCheckbox.checked = false;
                    }
                    updateSelectedLabel();
                });
            });

            function updateSelectedLabel() {
                const checkedBoxes = Array.from(otherCheckboxes).filter(cb => cb.checked);

                if (checkedBoxes.length === 0) {
                    allCheckbox.checked = true;
                    label.textContent = 'All Sources';
                } else if (checkedBoxes.length === 1) {
                    label.textContent = checkedBoxes[0].value;
                } else {
                    label.textContent = checkedBoxes.length + ' Sources Selected';
                }
            }
        }

        function getSelectedPaymentSources() {
            const allCheckbox = document.getElementById('sourceAll');

            if (allCheckbox.checked) {
                return null;
            }

            const checkedBoxes = document.querySelectorAll('.payment-source-checkbox:not(#sourceAll):checked');
            const selectedSources = Array.from(checkedBoxes).map(cb => cb.value);

            return selectedSources.length > 0 ? selectedSources : null;
        }

        async function loadTopUpReport() {
            const startDate = document.getElementById('startDateHidden').value;
            const endDate = document.getElementById('endDateHidden').value;
            const subCompany = document.getElementById('subCompany').value;
            const selectedSources = getSelectedPaymentSources();

            const resultDiv = document.getElementById('reportResult');
            resultDiv.innerHTML = `<div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-3x text-primary mb-3"></i><p>Loading transactions...</p></div>`;

            try {
                const params = new URLSearchParams();

                if (startDate) params.append('startDate', startDate);
                if (endDate) params.append('endDate', endDate);
                if (subCompany) params.append('subCompanyId', subCompany);

                if (selectedSources && selectedSources.length > 0) {
                    selectedSources.forEach(source => {
                        params.append('paymentSources', source);
                    });
                }

                const response = await fetch(`/TopUpReport/GetTopUpTransactions?${params.toString()}`);

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();

                if (result.success) {
                    displayReport(result.data);
                } else {
                    resultDiv.innerHTML = `<div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> ${result.message || 'Error loading data'}</div>`;
                    document.getElementById('summaryCards').style.display = 'none';
                }
            } catch (error) {
                console.error('Error:', error);
                resultDiv.innerHTML = `<div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> Error: ${error.message}</div>`;
                document.getElementById('summaryCards').style.display = 'none';
            }
        }

        function displayReport(data) {
            document.getElementById('summaryCards').style.display = 'flex';
            document.getElementById('totalTransactions').textContent = data.totalRecords || data.TotalRecords || 0;

            const totalAmount = data.totalAmount || data.TotalAmount || 0;
            document.getElementById('totalAmount').textContent =
                `KES ${parseFloat(totalAmount).toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

            const resultDiv = document.getElementById('reportResult');
            const transactions = data.data || data.Data || [];

            if (transactions.length === 0) {
                resultDiv.innerHTML = '<div class="alert alert-warning"><i class="fas fa-info-circle"></i> No top-up transactions found for the selected criteria.</div>';
                return;
            }

            let table = `
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="topUpTable">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Transaction ID</th>
                                <th>Payment Date</th>
                                <th>Payment Time</th>
                                <th>Sub Company ID</th>
                                <th>Sub Company Name</th>
                                <th>Payment Amount</th>
                                <th>Payment Source</th>
                                <th>Payment Mode</th>
                                <th>Operator</th>
                                <th>Status</th>
                                <th>Created By</th>
                                <th>Remark</th>
                            </tr>
                        </thead>
                        <tbody>`;

            let rowNumber = 1;
            transactions.forEach(row => {
                const paymentDate = formatDateOnly(row.payment_date);
                const paymentTime = row.payment_time || '';
                const amount = parseFloat(row.paidamount || 0).toFixed(2);

                table += `<tr>
                    <td>${rowNumber++}</td>
                    <td>${row.transaction_id || '-'}</td>
                    <td>${paymentDate}</td>
                    <td>${paymentTime}</td>
                    <td>${row.car_parkers_sub_co_id || '-'}</td>
                    <td>${row.car_parkers_sub_co_name || '-'}</td>
                    <td class="text-end"><strong>KES ${amount}</strong></td>
                    <td>${row.payment_source_name || '-'}</td>
                    <td>${row.payment_mode || '-'}</td>
                    <td>${row.operator_name || '-'}</td>
                    <td><span class="badge ${(row.transaction_status === 'Success' || row.transaction_status === 'Completed') ? 'bg-success' : 'bg-warning'}">${row.transaction_status || '-'}</span></td>
                    <td>${row.created_by || '-'}</td>
                    <td>${row.Remark || '-'}</td>
                </tr>`;
            });

            table += '</tbody></table></div>';
            resultDiv.innerHTML = table;
        }

        async function exportToExcel() {
            const startDate = document.getElementById('startDateHidden').value;
            const endDate = document.getElementById('endDateHidden').value;
            const subCompanyId = document.getElementById('subCompany').value;
            const subCompanyInput = document.getElementById('subCompanyInput');
            const selectedSources = getSelectedPaymentSources();

            try {
                let subCompanyName = 'AllCompanies';
                if (subCompanyId) {
                    const fullText = subCompanyInput.value;
                    subCompanyName = fullText.split('-')[1] || fullText;
                    subCompanyName = subCompanyName.replace(/\s/g, '').replace(/[^a-zA-Z0-9]/g, '');
                }

                let dateRange = '';
                if (startDate && endDate) {
                    const startParts = startDate.split('-');
                    const endParts = endDate.split('-');
                    dateRange = `_${startParts[0]}${startParts[1]}${startParts[2]}_to_${endParts[0]}${endParts[1]}${endParts[2]}`;
                }

                showMessage('Generating Excel file...', 'info');

                const response = await fetch('/TopUpReport/ExportToExcel', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        startDate: startDate || null,
                        endDate: endDate || null,
                        subCompanyId: subCompanyId || null,
                        paymentSources: selectedSources
                    })
                });

                if (response.ok) {
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    const fileName = `TOPUP_Report${dateRange}_${subCompanyName}.xls`;
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                    showMessage('Excel file downloaded successfully!', 'success');
                } else {
                    showMessage('Error generating Excel file', 'danger');
                }
            } catch (error) {
                showMessage('Error: ' + error.message, 'danger');
            }
        }

        function resetFilters() {
            setDefaultDates();
            document.getElementById('subCompanyInput').value = '';
            document.getElementById('subCompany').value = '';
            document.getElementById('reportResult').innerHTML =
                '<div class="text-center py-5"><i class="fas fa-info-circle fa-3x text-muted mb-3"></i><p class="text-muted">Click "Search" to load top-up transactions</p></div>';
            document.getElementById('summaryCards').style.display = 'none';
        }

                function showMessage(message, type) {
            // Show in modal instead of inline alert
            showModal(message, type);

            // Still update the inline alert for backwards compatibility
            var alertDiv = $("#statusMessage");
            alertDiv.removeClass().addClass("alert alert-" + type);
            alertDiv.html(message);
            alertDiv.fadeIn();
            setTimeout(function () {
                alertDiv.fadeOut();
            }, 5000);
        }

        function openWaiverModal() {
            loadCompaniesForWaiver();
            document.getElementById('waiverForm').reset();
            document.getElementById('wvr_companyId').value = '';
            document.getElementById('wvr_mobile').value = '';
            document.getElementById('wvr_cardType').value = '';
            document.getElementById('wvr_totalCards').value = '';
            document.getElementById('wvr_totalLimit').value = '';
            document.getElementById('wvr_email').value = '';
            document.getElementById('wvr_balance').value = '';
            document.getElementById('wvr_finalBalance').value = '';

            var modal = new bootstrap.Modal(document.getElementById('waiverModal'));
            modal.show();
        }

        async function loadCompaniesForWaiver() {
            try {
                const response = await fetch('/TopUpReport/GetSubCompanies');
                const result = await response.json();

                if (result.success) {
                    const select = document.getElementById('wvr_subCompanyId');
                    select.innerHTML = '<option value="">-- Select Company --</option>';

                    result.data.forEach(company => {
                        const option = document.createElement('option');
                        option.value = company.car_parkers_sub_co_id;
                        option.textContent = company.car_parkers_sub_co_name;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Error loading companies:', error);
            }
        }

        async function loadCompanyDetailsForWaiver() {
            const subCoId = document.getElementById('wvr_subCompanyId').value;

            if (!subCoId) {
                clearWaiverFields();
                return;
            }

            try {
                const response = await fetch(`/TopUpReport/GetCompanyDetailsForWaiver?subCoId=${subCoId}`);
                const result = await response.json();

                if (result.success && result.data) {
                    const data = result.data;

                    document.getElementById('wvr_companyId').value = data.car_parkers_sub_co_id || '';
                    document.getElementById('wvr_mobile').value = data.sub_co_car_parkers_contact_number || '';
                    document.getElementById('wvr_cardType').value = data.applicable_card_type || '';
                    document.getElementById('wvr_totalCards').value = data.Total_Cards_Under_Sub_Co || '0';
                    document.getElementById('wvr_totalLimit').value = 'KES ' + (data.Total_Card_Limit_Under_Sub_Co || '0');
                    document.getElementById('wvr_email').value = data.sub_co_car_parkers_email || '';
                    document.getElementById('wvr_balance').value = 'KES ' + (data.Balance_Amount || '0');

                    calculateFinalBalance();
                } else {
                    showMessage(result.message || 'Company not found', 'warning');
                }
            } catch (error) {
                console.error('Error loading company details:', error);
                showMessage('Error loading company details', 'danger');
            }
        }

        function calculateFinalBalance() {
            const balanceText = document.getElementById('wvr_balance').value;
            const topUpAmount = parseFloat(document.getElementById('wvr_topUpAmount').value) || 0;

            const currentBalance = parseFloat(balanceText.replace('KES ', '').replace(/,/g, '')) || 0;
            const finalBalance = currentBalance + topUpAmount;

            document.getElementById('wvr_finalBalance').value = 'KES ' + finalBalance.toFixed(2);
        }

        function clearWaiverFields() {
            document.getElementById('wvr_companyId').value = '';
            document.getElementById('wvr_mobile').value = '';
            document.getElementById('wvr_cardType').value = '';
            document.getElementById('wvr_totalCards').value = '';
            document.getElementById('wvr_totalLimit').value = '';
            document.getElementById('wvr_email').value = '';
            document.getElementById('wvr_balance').value = '';
            document.getElementById('wvr_finalBalance').value = '';
        }

        async function confirmWaiver() {
            const form = document.getElementById('waiverForm');

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const subCompanyId = document.getElementById('wvr_subCompanyId').value;
