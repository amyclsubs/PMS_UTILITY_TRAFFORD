                async function sendRequest() {
            const subCompanyId = document.getElementById('ct_subCompanyId').value;
            const tagNumber = document.getElementById('ct_tagNo').value;
            const topUpAmount = parseFloat(document.getElementById('ct_topUpAmount').value);
                    const mpesaPhoneRaw = document.getElementById('ct_mpesaPhone').value;
        const mpesaPhone = normalizePhoneNumber(mpesaPhoneRaw);
            const paymentModeElement = document.querySelector('input[name="ct_paymentMode"]:checked');

            // Validation
            if (!subCompanyId) {
                showMessage('Please select a company', 'warning');
                return;
            }

            if (!tagNumber) {
                showMessage('Please enter a tag number', 'warning');
                return;
            }

            if (!topUpAmount || topUpAmount <= 0) {
                showMessage('Please enter a valid top-up amount', 'warning');
                return;
            }

            if (!paymentModeElement) {
                showMessage('Please select a payment mode', 'warning');
                return;
            }

            const paymentMode = paymentModeElement.value;

            // Only MPESA requires STK Push
            if (paymentMode !== 'MPESA') {
                showMessage('Send Request is only available for MPESA payments. Use "Confirm" button for other payment modes.', 'warning');
                return;
            }

                    if (!mpesaPhone || !mpesaPhone.match(/^254[0-9]{9}$/)) {
            showMessage('Please enter a valid M-Pesa phone number (format: 0700123456 or 254700123456)', 'warning');
            return;
        }

            try {
                // Open tracking modal
                var trackingModal = new bootstrap.Modal(document.getElementById('paymentTrackingModal'));
                trackingModal.show();
                resetPaymentSteps();
                updatePaymentStep('step-stk-push', 'active');

                showMessage('Sending M-Pesa STK Push request...', 'info');

                // Step 1: Initiate STK Push
                const stkResponse = await fetch('/TopUpReport/InitiateMpesaTopUp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        tagNumber: tagNumber,
                        phoneNumber: mpesaPhone,
                        amount: topUpAmount,
                        paymentModeName: 'NEXTGEN R1 MPESA'
                    })
                });

                const stkResult = await stkResponse.json();

                if (!stkResult.success) {
                    showPaymentError('Failed to send STK Push: ' + (stkResult.message || 'Unknown error'));
                    showMessage('Failed to send STK Push: ' + (stkResult.message || 'Unknown error'), 'danger');
                    return;
                }

                updatePaymentStep('step-stk-push', 'completed');
                updatePaymentStep('step-awaiting', 'active');

                showMessage('STK Push sent to ' + mpesaPhone + '. Please enter M-Pesa PIN on your phone.', 'success');

                const checkoutRequestId = stkResult.checkoutRequestId;

                // Step 2: Auto-check status (8 attempts, 9 seconds apart = 72 seconds total)
                let maxAttempts = 8;
                let attempt = 0;
                let paymentSuccessful = false;
                let failureReason = '';

                while (attempt < maxAttempts && !paymentSuccessful) {
                    attempt++;

                    // Wait 9 seconds before checking
                    await new Promise(resolve => setTimeout(resolve, 9000));

                    updatePaymentStep('step-awaiting', 'completed');
                    updatePaymentStep('step-verifying', 'active');
                    updateStepDesc('step-verifying', 'Checking payment status... (Attempt ' + attempt + '/' + maxAttempts + ')');

                    showMessage('Checking payment status... (Attempt ' + attempt + '/' + maxAttempts + ')', 'info');

                    const statusResponse = await fetch('/TopUpReport/CheckMpesaStatus', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            checkoutRequestID: checkoutRequestId,
                            paymentModeName: 'NEXTGEN R1 MPESA'
                        })
                    });

                    const statusResult = await statusResponse.json();

                    // Log for debugging
                    console.log('Attempt ' + attempt + ' - ResultCode:', statusResult.resultCode, 'Message:', statusResult.resultDesc);

                    if (statusResult.success && statusResult.resultCode === '0') {
                        // Payment successful
                        paymentSuccessful = true;
                        break;
                    } else if (statusResult.success && statusResult.resultCode) {
                        // Only break on FINAL failure codes
                        const finalFailureCodes = ['1', '1032', '1037', '2001', '1001', '1019'];

                        if (finalFailureCodes.includes(statusResult.resultCode)) {
                            failureReason = statusResult.resultDesc || 'Payment failed';
                            break;
                        }
                        // Otherwise store last error but continue checking
                        failureReason = statusResult.resultDesc || 'Payment pending';
                    }
                    // If resultCode is null/empty, continue checking (still pending)
                }

                // Step 3: Process result
                if (paymentSuccessful) {
                    updatePaymentStep('step-verifying', 'completed');
                    updatePaymentStep('step-processing', 'active');

                    showMessage('Payment successful! Processing top-up...', 'success');

                    // Process the top-up in database
                    const topUpResponse = await fetch('/TopUpReport/AddCompanyTopUp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            subCompanyId: subCompanyId,
                            subCompanyName: document.getElementById('ct_subCompanyId').selectedOptions[0]?.text || '',
                            topUpAmount: topUpAmount,
                            remark: document.getElementById('ct_remark').value,
                            paymentMode: 'MPESA',
                            operatorName: 'System',
                            createdBy: 'Admin',
                            checkoutRequestID: checkoutRequestId
                        })
                    });

                    const topUpResult = await topUpResponse.json();

                    if (topUpResult.success) {
                        updatePaymentStep('step-processing', 'completed');
                        updatePaymentStep('step-completed', 'completed');

                        document.getElementById('txnAmount').textContent = 'KES ' + topUpAmount.toFixed(2);
                        document.getElementById('txnId').textContent = topUpResult.transactionId;
                        document.getElementById('transactionDetails').style.display = 'block';
                        document.getElementById('closeTrackingBtn').disabled = false;

                        // Fetch M-Pesa receipt (async)
                        fetchMpesaReceipt(checkoutRequestId);

                        showMessage('Top-up completed successfully! Transaction ID: ' + topUpResult.transactionId, 'success');
                        clearTopUpFields();

                        // Reload company details to show updated balance
                        if (subCompanyId) {
                            await loadCompanyDetailsForTopUp();
                        }
                    } else {
                        showPaymentError('Payment received but failed to process top-up. Please contact support.');
                        showMessage('Payment received but failed to process top-up. Please contact support.', 'danger');
                    }
                } else if (failureReason && failureReason !== 'Payment pending') {
                    // Definite failure
                    showPaymentError('Payment failed: ' + failureReason);
                    showMessage('Payment failed: ' + failureReason, 'danger');
                } else {
                    // Still processing after all attempts
                    showPaymentError('Payment is still being processed. Transaction ID: ' + checkoutRequestId + '. Please check your balance in a moment or contact support.');
                    document.getElementById('txnReceipt').textContent = checkoutRequestId;
                    document.getElementById('transactionDetails').style.display = 'block';
                    document.getElementById('closeTrackingBtn').disabled = false;
                    showMessage('Payment is still being processed. Transaction ID: ' + checkoutRequestId + '. Please check your balance shortly.', 'warning');
                }

            } catch (error) {
                console.error('Error:', error);
                showPaymentError('Error: ' + error.message);
                showMessage('Error: ' + error.message, 'danger');
            }
        }

                // ============ NEW: Modal Helper Functions ============
        function resetPaymentSteps() {
            var steps = ['step-stk-push', 'step-awaiting', 'step-verifying', 'step-processing', 'step-completed'];
            for (var i = 0; i < steps.length; i++) {
                var step = document.getElementById(steps[i]);
                if (step) {
                    step.classList.remove('active', 'completed', 'error');
                    var statusIcon = step.querySelector('.step-status i');
                    if (statusIcon) {
                        statusIcon.className = 'fas fa-ellipsis-h';
                    }
                }
            }

            var errorDiv = document.getElementById('paymentError');
            var detailsDiv = document.getElementById('transactionDetails');
            var closeBtn = document.getElementById('closeTrackingBtn');

            if (errorDiv) errorDiv.style.display = 'none';
            if (detailsDiv) detailsDiv.style.display = 'none';
            if (closeBtn) closeBtn.disabled = true;
        }

        function updatePaymentStep(stepId, status) {
            var step = document.getElementById(stepId);
            if (!step) return;

            step.classList.remove('active', 'completed', 'error');
            step.classList.add(status);

            var statusIcon = step.querySelector('.step-status i');
            if (statusIcon) {
                if (status === 'active') {
                    statusIcon.className = 'fas fa-spinner fa-spin';
                } else if (status === 'completed') {
                    statusIcon.className = 'fas fa-check-circle';
                } else if (status === 'error') {
                    statusIcon.className = 'fas fa-times-circle';
                }
            }
        }

        function updateStepDesc(stepId, description) {
            var step = document.getElementById(stepId);
            if (!step) return;

            var descElement = step.querySelector('.step-desc');
            if (descElement) {
                descElement.textContent = description;
            }
        }

        function showPaymentError(message) {
            var errorMsg = document.getElementById('errorMessage');
            var errorDiv = document.getElementById('paymentError');
            var closeBtn = document.getElementById('closeTrackingBtn');

            if (errorMsg) errorMsg.textContent = message;
            if (errorDiv) errorDiv.style.display = 'block';
            if (closeBtn) closeBtn.disabled = false;

            var activeStep = document.querySelector('.payment-step.active');
            if (activeStep) {
                activeStep.classList.remove('active');
                activeStep.classList.add('error');
            }
        }

        async function fetchMpesaReceipt(checkoutRequestId) {
            try {
                // Poll for receipt number (max 6 attempts, 5 seconds apart = 30 seconds)
                for (var i = 0; i < 6; i++) {
                    await new Promise(function(resolve) {
                        setTimeout(resolve, 5000);
                    });

                    var response = await fetch('/TopUpReport/GetMpesaReceipt?checkoutRequestId=' + encodeURIComponent(checkoutRequestId));
                    var result = await response.json();

                    if (result.success && result.receiptNumber) {
                        document.getElementById('txnReceipt').textContent = result.receiptNumber;
                        return;
                    }
                }
                document.getElementById('txnReceipt').textContent = 'Not available yet';
            } catch (error) {
                console.error('Error fetching receipt:', error);
                document.getElementById('txnReceipt').textContent = 'Not available';
            }
        }
                // Normalize phone number to 254XXXXXXXXX format
        function normalizePhoneNumber(phone) {
            if (!phone) return '';

            // Remove all spaces, dashes, and other non-numeric characters
            phone = phone.replace(/\D/g, '');

            // If starts with 0, replace with 254
            if (phone.startsWith('0')) {
                phone = '254' + phone.substring(1);
            }

            // If starts with +254, remove the +
            if (phone.startsWith('+254')) {
                phone = phone.substring(1);
            }

            // If starts with 254, it's already correct
            if (phone.startsWith('254')) {
                return phone;
            }

            // If it's 9 digits (without country code), add 254
            if (phone.length === 9) {
                return '254' + phone;
            }

            return phone;
        }
                // Modal Helper Functions
        function showModal(message, type = 'info') {
            const modal = document.getElementById('messageModal');
            const header = document.getElementById('messageModalHeader');
            const title = document.getElementById('messageModalTitle');
            const body = document.getElementById('messageModalBody');

            // Set colors based on type
            header.className = 'modal-header';
            if (type === 'error' || type === 'danger') {
                header.classList.add('bg-danger', 'text-white');
                title.innerHTML = '<i class="fas fa-exclamation-circle"></i> Error';
            } else if (type === 'warning') {
                header.classList.add('bg-warning', 'text-dark');
                title.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Warning';
            } else if (type === 'success') {
                header.classList.add('bg-success', 'text-white');
                title.innerHTML = '<i class="fas fa-check-circle"></i> Success';
            } else {
                header.classList.add('bg-info', 'text-white');
                title.innerHTML = '<i class="fas fa-info-circle"></i> Information';
            }

            body.innerHTML = '<p class="mb-0">' + message + '</p>';

            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();
        }

        function showConfirm(message, onConfirm) {
            const modal = document.getElementById('confirmModal');
            const body = document.getElementById('confirmModalBody');
            const yesBtn = document.getElementById('confirmYesBtn');

            body.innerHTML = '<p class="mb-0">' + message + '</p>';

            // Remove previous click handlers
            const newYesBtn = yesBtn.cloneNode(true);
            yesBtn.parentNode.replaceChild(newYesBtn, yesBtn);

            newYesBtn.addEventListener('click', function() {
                const bsModal = bootstrap.Modal.getInstance(modal);
                bsModal.hide();
                if (onConfirm) onConfirm();
            });

            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();
        }

