@{
    ViewData["Title"] = "Top-Up Report";
}

<div class="container-fluid" style="padding-top: 10px;">

    <div id="statusMessage" class="alert" style="display:none; margin-bottom: 20px;"></div>

    <!-- TABS -->
    <ul class="nav nav-tabs" id="topupTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="company-topup-tab" data-bs-toggle="tab" data-bs-target="#company-topup" type="button" role="tab">
                <i class="fas fa-building"></i> Company TOP-UP
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="report-tab" data-bs-toggle="tab" data-bs-target="#report" type="button" role="tab">
                <i class="fas fa-file-alt"></i> TOP-UP Report
            </button>
        </li>
    </ul>

    <div class="tab-content" id="topupTabsContent">
        <!-- COMPANY TOP-UP TAB -->
        <div class="tab-pane fade" id="company-topup" role="tabpanel">
            <div class="card shadow-sm mt-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-building"></i> Company TOP-UP Management</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Left Column -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>COMPANY NAME</strong></label>
                                <select id="ct_subCompanyId" class="form-select">
                                    <option value="">-- Select Company --</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>COMPANY ID</strong></label>
                                <input type="text" id="ct_companyId" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>MOBILE NO</strong></label>
                                <input type="text" id="ct_mobile" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>CARD TYPE</strong></label>
                                <input type="text" id="ct_cardType" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>TOTAL CARDS</strong></label>
                                <input type="text" id="ct_totalCards" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>TOTAL CARD LIMIT</strong></label>
                                <input type="text" id="ct_totalLimit" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>TAG NO</strong></label>
                                <input type="text" id="ct_tagNo" class="form-control" placeholder="Type tag number..." />
                                <small class="text-muted">Type tag number to auto-fill company details</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>KRA PIN</strong></label>
                                <input type="text" id="ct_kraPin" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>EMAIL</strong></label>
                                <input type="text" id="ct_email" class="form-control" readonly />
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>CURRENT BALANCE</strong></label>
                                <input type="text" id="ct_balance" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>TOP-UP AMOUNT</strong></label>
                                <input type="number" id="ct_topUpAmount" class="form-control" placeholder="Enter amount" min="1" step="0.01" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>FINAL BALANCE</strong></label>
                                <input type="text" id="ct_finalBalance" class="form-control bg-light" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>REMARK</strong></label>
                                <input type="text" id="ct_remark" class="form-control" placeholder="Enter remark" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>MPESA PHONE NUMBER</strong></label>
                                <input type="tel" id="ct_mpesaPhone" class="form-control" placeholder="0700123456" maxlength="13" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>Mode Of Payment</strong><span class="text-danger">*</span></label>
                                <div style="max-width: 600px;">
                                    <div class="d-flex gap-2 mb-3">
                                        <div class="form-check payment-option-small flex-fill">
                                            <input class="form-check-input" type="radio" name="ct_paymentMode" id="ct_mpesa" value="MPESA">
                                            <label class="form-check-label payment-label-small" for="ct_mpesa">
                                                <i class="fas fa-mobile-alt"></i> MPESA
                                            </label>
                                        </div>
                                        <div class="form-check payment-option-small flex-fill">
                                            <input class="form-check-input" type="radio" name="ct_paymentMode" id="ct_cash" value="CASH">
                                            <label class="form-check-label payment-label-small" for="ct_cash">
                                                <i class="fas fa-money-bill-wave"></i> CASH
                                            </label>
                                        </div>
                                        <div class="form-check payment-option-small flex-fill">
                                            <input class="form-check-input" type="radio" name="ct_paymentMode" id="ct_mpesavia" value="MPESA VIA PAYBILL">
                                            <label class="form-check-label payment-label-small" for="ct_mpesavia">
                                                <i class="fas fa-credit-card"></i> PAYBILL
                                            </label>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 mb-2">
                                        <button class="btn btn-success btn-custom flex-fill" onclick="confirmTopUp()">
                                            <i class="fas fa-check-circle"></i> Confirm
                                        </button>
                                        <button class="btn btn-danger btn-custom flex-fill" onclick="cancelTopUp()">
                                            <i class="fas fa-times-circle"></i> Cancel
                                        </button>
                                    </div>

                                    <button class="btn btn-primary btn-custom w-100" onclick="sendRequest()">
                                        <i class="fas fa-paper-plane"></i> Send Request
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- List Of Tags Section -->
                    <div class="row mt-4">
                        <div class="col-md-12">
                            <div class="card">
                                <div class="card-header bg-dark text-white">
                                    <h6 class="mb-0">List Of Tags</h6>
                                </div>
                                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                                    <div id="tagListContainer">
                                        <p class="text-muted text-center">Select a company to view tags</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOP-UP REPORT TAB (Existing report) -->
        <div class="tab-pane fade show active" id="report" role="tabpanel">
            <!-- Filters Card -->
            <div class="card shadow-sm mb-4 mt-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-filter"></i> Filters</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label"><strong>Start Date</strong></label>
                            <input type="text" id="startDate" class="form-control datepicker" placeholder="DD-MMM-YYYY" readonly />
                            <input type="hidden" id="startDateHidden" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><strong>End Date</strong></label>
                            <input type="text" id="endDate" class="form-control datepicker" placeholder="DD-MMM-YYYY" readonly />
                            <input type="hidden" id="endDateHidden" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><strong>Sub Company</strong></label>
                            <input list="subCompanyList" id="subCompanyInput" class="form-control" placeholder="Type to search sub company" />
                            <datalist id="subCompanyList"></datalist>
                            <input type="hidden" id="subCompany" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><strong>Payment Source</strong></label>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="paymentSourceDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span id="selectedSourcesLabel">All Sources</span>
                                </button>
                                <ul class="dropdown-menu w-100 p-2" id="paymentSourceList" aria-labelledby="paymentSourceDropdown" style="max-height: 300px; overflow-y: auto;">
                                    <li>
                                        <div class="form-check">
                                            <input class="form-check-input payment-source-checkbox" type="checkbox" value="All" id="sourceAll" checked>
                                            <label class="form-check-label" for="sourceAll">All Sources</label>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <button class="btn btn-primary" onclick="loadTopUpReport()">
                                <i class="fas fa-search"></i> Search
                            </button>
                            <button class="btn btn-success" onclick="exportToExcel()">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                            <button class="btn btn-secondary" onclick="resetFilters()">
                                <i class="fas fa-redo"></i> Reset
                            </button>
                            <button class="btn btn-warning" onclick="openWaiverModal()">
                                <i class="fas fa-hand-holding-usd"></i> Add Waiver/Discount
                            </button>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-12">
                            <button class="btn btn-outline-primary btn-sm me-1" id="thisMonthBtn">This Month</button>
                            <button class="btn btn-outline-primary btn-sm me-1" id="lastMonthBtn">Previous Month</button>
                            <button class="btn btn-outline-secondary btn-sm me-1" id="thisYearBtn">This Year</button>
                            <button class="btn btn-outline-secondary btn-sm" id="lastYearBtn">Previous Year</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary Cards -->
            <div class="row mb-4" id="summaryCards" style="display:none;">
                <div class="col-md-6">
                    <div class="card bg-info text-white h-100">
                        <div class="card-body text-center">
                            <h6 class="card-title">Total Transactions</h6>
                            <h2 class="mb-0" id="totalTransactions">0</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-success text-white h-100">
                        <div class="card-body text-center">
                            <h6 class="card-title">Total Amount</h6>
                            <h2 class="mb-0" id="totalAmount">KES 0.00</h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Report Table -->
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-table"></i> Top-Up Transactions</h5>
                </div>
                <div class="card-body">
                    <div id="reportResult">
                        <div class="text-center py-5">
                            <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Click "Search" to load top-up transactions</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Existing Waiver Modal (keep as is) -->
<div class="modal fade" id="waiverModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-hand-holding-usd"></i> Add Waiver / Discount</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="waiverForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>COMPANY NAME</strong></label>
                                <select id="wvr_subCompanyId" class="form-select" required>
                                    <option value="">-- Select Company --</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>COMPANY ID</strong></label>
                                <input type="text" id="wvr_companyId" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>MOBILE NO</strong></label>
                                <input type="text" id="wvr_mobile" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>CARD TYPE</strong></label>
                                <input type="text" id="wvr_cardType" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>TOTAL CARDS</strong></label>
                                <input type="text" id="wvr_totalCards" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>TOTAL CARD LIMIT</strong></label>
                                <input type="text" id="wvr_totalLimit" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>FINAL BALANCE</strong></label>
                                <input type="text" id="wvr_finalBalance" class="form-control bg-light" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>EMAIL</strong></label>
                                <input type="text" id="wvr_email" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>BALANCE</strong></label>
                                <input type="text" id="wvr_balance" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>Top-Up Amount</strong><span class="text-danger">*</span></label>
                                <input type="number" id="wvr_topUpAmount" class="form-control" placeholder="Enter amount" required min="1" step="0.01" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>REMARK</strong></label>
                                <input type="text" id="wvr_remark" class="form-control" placeholder="Enter remark" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>Mode Of Payment</strong><span class="text-danger">*</span></label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="wvr_paymentMode" id="wvr_waiver" value="Waiver" checked>
                                        <label class="form-check-label" for="wvr_waiver">WAIVER</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="wvr_paymentMode" id="wvr_discount" value="Discount">
                                        <label class="form-check-label" for="wvr_discount">DISCOUNT</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="confirmWaiver()">
                    <i class="fas fa-check"></i> Confirm
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
            </div>
        </div>
    </div>
</div>
<!-- TOP-UP Confirmation Modal -->
<div class="modal fade" id="topupConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-check-circle"></i> Confirm TOP-UP</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6 class="mb-3">Please verify the following details:</h6>
                <table class="table table-bordered">
                    <tr>
                        <th width="40%">Company Name:</th>
                        <td id="confirm_companyName"></td>
                    </tr>
                    <tr>
                        <th>Company ID:</th>
                        <td id="confirm_companyId"></td>
                    </tr>
                    <tr>
                        <th>TOP-UP Amount:</th>
                        <td id="confirm_amount" class="text-success fw-bold"></td>
                    </tr>
                    <tr>
                        <th>Mode of Payment:</th>
                        <td id="confirm_paymentMode" class="text-primary fw-bold"></td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="processTopUp()">
                    <i class="fas fa-check"></i> Confirm TOP-UP
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Error/Info Modal -->
<div class="modal fade" id="messageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header" id="messageModalHeader">
                <h5 class="modal-title" id="messageModalTitle">
                    <i class="fas fa-info-circle"></i> Message
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="messageModalBody">
                <!-- Message content -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <i class="fas fa-question-circle"></i> Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="confirmModalBody">
                <!-- Confirmation message -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmYesBtn">Yes</button>
            </div>
        </div>
    </div>
</div>
<!-- Payment Tracking Modal -->
<div class="modal fade" id="paymentTrackingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title"><i class="fas fa-mobile-alt"></i> M-Pesa Payment Tracking</h5>
            </div>
            <div class="modal-body p-4">
                <!-- Progress Steps -->
                <div class="payment-steps">
                    <!-- Step 1: STK Push Sent -->
                    <div class="payment-step" id="step-stk-push">
                        <div class="step-icon">
                            <i class="fas fa-paper-plane"></i>
                        </div>
                        <div class="step-content">
                            <h6 class="step-title">STK Push Sent</h6>
                            <p class="step-desc">Payment request sent to your phone</p>
                        </div>
                        <div class="step-status">
                            <i class="fas fa-spinner fa-spin"></i>
                        </div>
                    </div>

                    <!-- Step 2: Awaiting Payment -->
                    <div class="payment-step" id="step-awaiting">
                        <div class="step-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="step-content">
                            <h6 class="step-title">Awaiting Payment</h6>
                            <p class="step-desc">Please enter your M-Pesa PIN</p>
                        </div>
                        <div class="step-status">
                            <i class="fas fa-ellipsis-h"></i>
                        </div>
                    </div>

                    <!-- Step 3: Verifying Payment -->
                    <div class="payment-step" id="step-verifying">
                        <div class="step-icon">
                            <i class="fas fa-search"></i>
                        </div>
                        <div class="step-content">
                            <h6 class="step-title">Verifying Payment</h6>
                            <p class="step-desc">Checking transaction status</p>
                        </div>
                        <div class="step-status">
                            <i class="fas fa-ellipsis-h"></i>
                        </div>
                    </div>

                    <!-- Step 4: Processing Top-Up -->
                    <div class="payment-step" id="step-processing">
                        <div class="step-icon">
                            <i class="fas fa-cog"></i>
                        </div>
                        <div class="step-content">
                            <h6 class="step-title">Processing Top-Up</h6>
                            <p class="step-desc">Adding balance to your account</p>
                        </div>
                        <div class="step-status">
                            <i class="fas fa-ellipsis-h"></i>
                        </div>
                    </div>

                    <!-- Step 5: Completed -->
                    <div class="payment-step" id="step-completed">
                        <div class="step-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="step-content">
                            <h6 class="step-title">Top-Up Successful</h6>
                            <p class="step-desc">Your account has been credited</p>
                        </div>
                        <div class="step-status">
                            <i class="fas fa-ellipsis-h"></i>
                        </div>
                    </div>
                </div>

                <!-- Transaction Details -->
                <div class="transaction-details mt-4" id="transactionDetails" style="display: none;">
                    <div class="alert alert-success mb-0">
                        <p class="mb-1"><strong>Amount:</strong> <span id="txnAmount"></span></p>
                        <p class="mb-0"><strong>Transaction ID:</strong> <span id="txnId"></span></p>
                    </div>
                </div>

                <!-- Error Message -->
                <div class="alert alert-danger mt-3 mb-0" id="paymentError" style="display: none;">
                    <i class="fas fa-exclamation-triangle"></i> <span id="errorMessage"></span>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" id="closeTrackingBtn" disabled>Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <style>
        .datepicker {
            cursor: pointer;
            background-color: white !important;
        }

        .tag-item {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            background-color: #f8f9fa;
            margin-bottom: 5px;
            border-radius: 4px;
        }

            .tag-item:hover {
                background-color: #e9ecef;
            }

        .payment-option-small {
            margin-bottom: 0;
        }

            .payment-option-small input[type="radio"] {
                display: none;
            }

        /* Fix payment mode button alignment - equal width */
        .payment-option-small {
            margin-bottom: 0;
            flex: 1 1 0;
            min-width: 0;
        }

        .payment-label-small {
            display: block;
            padding: 14px 10px;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background-color: #fff;
            font-weight: 600;
            white-space: nowrap;
            font-size: 16px;
            min-height: 52px;
            width: 100%;
        }

            .payment-label-small:hover {
                border-color: #0d6efd;
                background-color: #f8f9fa;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
