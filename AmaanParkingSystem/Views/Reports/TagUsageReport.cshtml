@model List<AmaanParkingSystem.Models.Reports.TagUsageReportModel>

@{
    ViewData["Title"] = "Cards Usage Report";
    var cardTypeList = ViewBag.CardTypeList as List<string> ?? new List<string>();
}

<div class="container-fluid mt-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1" style="font-size: 28px;">
            <i class="fas fa-tag text-primary me-2"></i>
            Cards Usage Report
        </h2>
        <p class="text-muted mb-0" style="font-size: 14px;">
            <i class="fas fa-clock me-1"></i>
            Last usage tracking for all registered tags (including Temporary)
        </p>
        <hr class="mt-3" style="border-top: 3px solid #667eea; width: 80px; opacity: 0.6;">
    </div>

    <!-- Search and Filters Section -->
    <div class="row g-2 mb-3 align-items-end">
        <div class="col-auto">
            <input id="searchBox" type="text" class="search-input" placeholder="🔍 Search by card name, plate no, company..." />
        </div>
        <div class="col-auto">
            <select id="cardTypeFilter" class="form-select form-select-sm" style="min-width:160px;">
                <option value="">All Card Types</option>
                @foreach (var ct in cardTypeList)
                {
                    <option value="@ct">@ct</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <select id="daysSinceSort" class="form-select form-select-sm" style="min-width:160px;">
                <option value="">Days Since — Default</option>
                <option value="asc">Days Since ↑ Ascending</option>
                <option value="desc">Days Since ↓ Descending</option>
            </select>
        </div>
    </div>

    <div class="button-section mb-3 d-flex align-items-center gap-3">
        <button class="btn btn-success btn-custom" onclick="exportReport()">
            <i class="fas fa-file-excel"></i> Export to Excel
        </button>
        <span class="text-muted">
            <strong>Showing:</strong> <span id="visibleCount">@Model.Count</span> of <strong>Total: @Model.Count</strong>
        </span>
    </div>

    <!-- Report Table -->
    <div class="table-responsive">
        <table class="table table-hover table-bordered" id="reportTable" style="width:100%;table-layout:auto;">
            <thead class="table-dark">
                <tr>
                    <th style="min-width:100px;">Card No</th>
                    <th style="min-width:120px;">Card Name</th>
                    <th style="min-width:100px;">Card Type</th>
                    <th style="min-width:150px;">Sub Company</th>
                    <th style="min-width:100px;">Plate No</th>
                    <th style="min-width:130px;">Owner Name</th>
                    <th style="min-width:150px;">Last Entry</th>
                    <th style="min-width:150px;">Last Exit</th>
                    <th style="min-width:100px;">Daily Charge</th>
                    <th style="min-width:100px;">Penalty</th>
                    <th style="min-width:100px;">Total</th>
                    <th style="min-width:100px;">Days Since</th>
                    <th style="min-width:100px;">Status</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @foreach (var item in Model)
                {
                    var rowClass = item.usage_status == "Never Used" ? "table-warning" :
                    item.days_since_last_use > 30 ? "table-danger" :
                    item.days_since_last_use > 7 ? "table-info" : "";

                    <tr class="@rowClass"
                        data-cardtype="@(item.card_type_remark ?? item.card_type)"
                        data-days="@(item.days_since_last_use.HasValue? item.days_since_last_use.Value.ToString() : "99999")">
                        <td style="word-break:break-word;">@item.cardno</td>
                        <td style="word-break:break-word;">@item.cardname</td>
                        <td>@(item.card_type_remark ?? item.card_type)</td>
                        <td style="word-break:break-word;">@item.car_parkers_sub_co_name</td>
                        <td>@item.car_plate_no</td>
                        <td style="word-break:break-word;">@item.car_owner_name</td>
                        <td>@(item.last_entry_time?.ToString("dd-MMM-yyyy HH:mm") ?? "Never")</td>
                        <td>@(item.last_exit_time?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                        <td style="text-align:right;">@(item.daily_charge?.ToString("0.00") ?? "0.00")</td>
                        <td style="text-align:right;">@(item.penalty_charge?.ToString("0.00") ?? "0.00")</td>
                        <td style="text-align:right;">@(item.total_charge?.ToString("0.00") ?? "0.00")</td>
                        <td style="text-align:center;">
                            @if (item.days_since_last_use.HasValue)
                            {
                                <span class="badge bg-secondary">@item.days_since_last_use days</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Never</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <span class="badge @(item.usage_status == "Active" ? "bg-success" :
                                                                                   item.usage_status == "Recently Used" ? "bg-info" :
                                                                                   item.usage_status == "Inactive" ? "bg-danger" : "bg-warning text-dark")">
                            @item.usage_status
                        </span>
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-muted" style="font-size:13px;">Rows per page:</label>
            <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                <option value="25">25</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>
        </div>
        <nav>
            <ul class="pagination pagination-sm mb-0" id="paginationControls"></ul>
        </nav>
        <span id="pageInfo" class="text-muted" style="font-size:13px;"></span>
    </div>
</div>

<style>
    .search-section {
        margin-bottom: 15px;
    }

    .search-input {
        width: 400px;
        padding: 6px 15px;
        border: 2px solid #d1d3e2;
        border-radius: 8px;
        font-size: 14px;
        color: #000000;
        transition: all 0.3s;
        height: 32px;
    }

        .search-input:focus {
            outline: none;
            border-color: #4e73df;
            box-shadow: 0 0 8px rgba(78, 115, 223, 0.2);
        }

    .button-section {
        margin-bottom: 15px;
    }

    .btn-custom {
        padding: 6px 20px;
        font-size: 14px;
        font-weight: 500;
        border-radius: 6px;
        border: none;
        transition: all 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

    .table th {
        background-color: #2c3e50;
        color: white;
        font-weight: 600;
        font-size: 13px;
        padding: 12px 8px;
    }

    .table td {
        font-size: 13px;
        padding: 10px 8px;
        vertical-align: middle;
    }

    .badge {
        padding: 6px 10px;
        font-size: 11px;
        font-weight: 600;
    }

    .page-link {
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .search-input {
            width: 100%;
        }
    }
</style>

<script>
    // ── Master data: all rows from DOM ──────────────────────
    var allRows = [];
    var filteredRows = [];
    var currentPage = 1;
    var pageSize = 50;

    document.addEventListener('DOMContentLoaded', function () {
        var tbody = document.getElementById('tableBody');
        allRows = Array.from(tbody.querySelectorAll('tr'));
        filteredRows = allRows.slice();

        document.getElementById('searchBox').addEventListener('input', applyFilters);
        document.getElementById('cardTypeFilter').addEventListener('change', applyFilters);
        document.getElementById('daysSinceSort').addEventListener('change', applyFilters);
        document.getElementById('pageSizeSelect').addEventListener('change', function () {
            pageSize = parseInt(this.value);
            currentPage = 1;
            renderPage();
        });

        renderPage();
    });

    function applyFilters() {
        var searchVal = document.getElementById('searchBox').value.toLowerCase();
        var cardType  = document.getElementById('cardTypeFilter').value.toLowerCase();
        var sortDir   = document.getElementById('daysSinceSort').value;

        // Filter across ALL rows (not just current page)
        filteredRows = allRows.filter(function (row) {
            var text       = row.innerText.toLowerCase();
            var rowCT      = (row.getAttribute('data-cardtype') || '').toLowerCase();
            var matchSearch = !searchVal || text.includes(searchVal);
            var matchType   = !cardType  || rowCT === cardType;
            return matchSearch && matchType;
        });

        // Sort by Days Since if requested
        if (sortDir === 'asc' || sortDir === 'desc') {
            filteredRows.sort(function (a, b) {
                var da = parseInt(a.getAttribute('data-days')) || 99999;
                var db = parseInt(b.getAttribute('data-days')) || 99999;
                return sortDir === 'asc' ? da - db : db - da;
            });
        }

        currentPage = 1;
        renderPage();
    }

    function renderPage() {
        var tbody  = document.getElementById('tableBody');
        var start  = (currentPage - 1) * pageSize;
        var end    = start + pageSize;
        var pageRows = filteredRows.slice(start, end);

        // Hide all rows first
        allRows.forEach(function (r) { r.style.display = 'none'; });

        // Show only current page rows in correct sort order
        // We re-append to tbody so DOM order matches filteredRows sort
        pageRows.forEach(function (r) {
            tbody.appendChild(r);
            r.style.display = '';
        });

        document.getElementById('visibleCount').textContent = filteredRows.length;
        updatePagination();
    }

    function updatePagination() {
        var totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));
        var ul = document.getElementById('paginationControls');
        ul.innerHTML = '';

        var maxVisible = 7;
        var pages = [];

        if (totalPages <= maxVisible) {
            for (var i = 1; i <= totalPages; i++) pages.push(i);
        } else {
            pages.push(1);
            if (currentPage > 3) pages.push('...');
            for (var i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) pages.push(i);
            if (currentPage < totalPages - 2) pages.push('...');
            pages.push(totalPages);
        }

        // Prev
        var prevLi = document.createElement('li');
        prevLi.className = 'page-item' + (currentPage === 1 ? ' disabled' : '');
        prevLi.innerHTML = '<a class="page-link" href="#">&laquo;</a>';
        prevLi.addEventListener('click', function (e) { e.preventDefault(); if (currentPage > 1) { currentPage--; renderPage(); } });
        ul.appendChild(prevLi);

        pages.forEach(function (p) {
            var li = document.createElement('li');
            if (p === '...') {
                li.className = 'page-item disabled';
                li.innerHTML = '<span class="page-link">…</span>';
            } else {
                li.className = 'page-item' + (p === currentPage ? ' active' : '');
                li.innerHTML = '<a class="page-link" href="#">' + p + '</a>';
                (function (pg) {
                    li.addEventListener('click', function (e) { e.preventDefault(); currentPage = pg; renderPage(); });
                })(p);
            }
            ul.appendChild(li);
        });

        // Next
        var nextLi = document.createElement('li');
        nextLi.className = 'page-item' + (currentPage === totalPages ? ' disabled' : '');
        nextLi.innerHTML = '<a class="page-link" href="#">&raquo;</a>';
        nextLi.addEventListener('click', function (e) { e.preventDefault(); if (currentPage < totalPages) { currentPage++; renderPage(); } });
        ul.appendChild(nextLi);

        var start = (currentPage - 1) * pageSize + 1;
        var end   = Math.min(currentPage * pageSize, filteredRows.length);
        document.getElementById('pageInfo').textContent =
            filteredRows.length === 0 ? 'No records' : 'Showing ' + start + '–' + end + ' of ' + filteredRows.length;
    }

    function exportReport() {
        window.location = '/Reports/ExportTagUsageReport';
    }
</script>
