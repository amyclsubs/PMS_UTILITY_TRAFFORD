@{
    ViewData["Title"] = "Manual Gate Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .device-badge {
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        display: inline-block;
        min-width: 80px;
        text-align: center;
        letter-spacing: 0.5px;
    }

    .operation-badge {
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 700;
        border-radius: 6px;
        display: inline-block;
        min-width: 90px;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .operation-open {
        background-color: #28a745;
        color: white;
        border: 2px solid #1e7e34;
        box-shadow: 0 2px 4px rgba(40, 167, 69, 0.3);
    }

    .operation-close {
        background-color: #dc3545;
        color: white;
        border: 2px solid #bd2130;
        box-shadow: 0 2px 4px rgba(220, 53, 69, 0.3);
    }

    .device-entry {
        background-color: #17a2b8;
        color: white;
        border: 1px solid #138496;
    }

    .device-exit {
        background-color: #6f42c1;
        color: white;
        border: 1px solid #5a32a3;
    }

    .device-entry2 {
        background-color: #fd7e14;
        color: white;
        border: 1px solid #dc6502;
    }

    .device-exit2 {
        background-color: #e83e8c;
        color: white;
        border: 1px solid #c21766;
    }

    .device-default {
        background-color: #6c757d;
        color: white;
        border: 1px solid #545b62;
    }

    #manualGateTable tbody tr:hover {
        background-color: #f8f9fa;
    }

    #manualGateTable td {
        vertical-align: middle;
    }
</style>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-door-open me-2"></i>Manual Gate Report</h5>
                </div>
                <div class="card-body">
                    <!-- Filter Section -->
                    <div class="row mb-4">
                        <div class="col-md-12 d-flex flex-wrap gap-2 align-items-center">
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-outline-primary active" id="btnToday" onclick="filterReport('today')">
                                    <i class="fas fa-calendar-day me-1"></i>Today
                                </button>
                                <button type="button" class="btn btn-outline-primary" id="btnYesterday" onclick="filterReport('yesterday')">
                                    <i class="fas fa-calendar-minus me-1"></i>Yesterday
                                </button>
                                <button type="button" class="btn btn-outline-primary" id="btnLastWeek" onclick="filterReport('lastweek')">
                                    <i class="fas fa-calendar-week me-1"></i>Last Week
                                </button>
                                <button type="button" class="btn btn-outline-primary" id="btnLastMonth" onclick="filterReport('lastmonth')">
                                    <i class="fas fa-calendar me-1"></i>Last Month
                                </button>
                            </div>

                            <button type="button" class="btn btn-outline-primary" id="btnDateRange" onclick="toggleDateRange()">
                                <i class="fas fa-calendar-alt me-1"></i>Date Range
                            </button>
                        </div>
                    </div>

                    <!-- Date Range Picker -->
                    <div class="row mb-4 d-none" id="dateRangeSection">
                        <div class="col-md-3">
                            <label for="startDate" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="startDate" />
                        </div>
                        <div class="col-md-3">
                            <label for="endDate" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="endDate" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="button" class="btn btn-primary me-2" onclick="applyDateRange()">
                                <i class="fas fa-search me-1"></i>Apply
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="cancelDateRange()">
                                <i class="fas fa-times me-1"></i>Cancel
                            </button>
                        </div>
                    </div>

                    <!-- Stats Cards -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted">Total Records</h6>
                                    <h3 id="totalRecords">0</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted">Date Range</h6>
                                    <h6 id="dateRangeDisplay">-</h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Export Button -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-success" onclick="exportReport()">
                                <i class="fas fa-file-excel me-1"></i>Export to Excel
                            </button>
                        </div>
                    </div>

                    <!-- Data Table -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover table-bordered" id="manualGateTable">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Id</th>
                                            <th>Device</th>
                                            <th>Operation</th>
                                            <th>Remark</th>
                                            <th>Created By</th>
                                            <th>Created On</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tableBody">
                                        <tr>
                                            <td colspan="6" class="text-center">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            let currentFilter = 'today';
            let currentStartDate = null;
            let currentEndDate = null;

            // Button ID map for all filter buttons
            const filterBtnMap = {
                'today':     'btnToday',
                'yesterday': 'btnYesterday',
                'lastweek':  'btnLastWeek',
                'lastmonth': 'btnLastMonth'
            };

            function getDeviceClass(device) {
                if (!device || device === '-') return 'device-default';
                const d = device.toLowerCase();
                if (d.includes('entry2') || d.includes('entry 2')) return 'device-entry2';
                if (d.includes('exit2')  || d.includes('exit 2'))  return 'device-exit2';
                if (d.includes('entry')) return 'device-entry';
                if (d.includes('exit'))  return 'device-exit';
                return 'device-default';
            }

            window.filterReport = function (filterType) {
                currentFilter = filterType;
                currentStartDate = null;
                currentEndDate = null;

                // Reset all btn-group buttons, highlight active
                document.querySelectorAll('.btn-group button').forEach(b => b.classList.remove('active'));
                const activeBtn = document.getElementById(filterBtnMap[filterType]);
                if (activeBtn) activeBtn.classList.add('active');

                document.getElementById('dateRangeSection').classList.add('d-none');
                document.getElementById('btnDateRange').classList.remove('active');

                loadReportData();
            };

            window.toggleDateRange = function () {
                const section = document.getElementById('dateRangeSection');
                const btn = document.getElementById('btnDateRange');

                section.classList.toggle('d-none');
                btn.classList.toggle('active');

                document.querySelectorAll('.btn-group button').forEach(b => b.classList.remove('active'));

                const today = new Date().toISOString().split('T')[0];
                document.getElementById('startDate').value = today;
                document.getElementById('endDate').value = today;
            };

            window.applyDateRange = function () {
                const startDate = document.getElementById('startDate').value;
                const endDate = document.getElementById('endDate').value;

                if (!startDate || !endDate) { alert('Please select both start and end dates'); return; }
                if (new Date(startDate) > new Date(endDate)) { alert('Start date cannot be greater than end date'); return; }

                currentFilter = 'daterange';
                currentStartDate = startDate;
                currentEndDate = endDate;

                loadReportData();
            };

            window.cancelDateRange = function () {
                document.getElementById('dateRangeSection').classList.add('d-none');
                document.getElementById('btnDateRange').classList.remove('active');
                filterReport('today');
            };

            function loadReportData() {
                document.getElementById('tableBody').innerHTML = `
                    <tr><td colspan="6" class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </td></tr>`;

                fetch('@Url.Action("GetManualGateReportData", "Reports")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({
                        filterType:  currentFilter,
                        startDate:   currentStartDate || '',
                        endDate:     currentEndDate || ''
                    })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        displayReportData(data.data);
                        document.getElementById('totalRecords').textContent = data.recordCount;
                        document.getElementById('dateRangeDisplay').textContent = data.dateRange;
                    } else {
                        document.getElementById('tableBody').innerHTML = `
                            <tr><td colspan="6" class="text-center text-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>${data.message}
                            </td></tr>`;
                    }
                })
                .catch(error => {
                    document.getElementById('tableBody').innerHTML = `
                        <tr><td colspan="6" class="text-center text-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>Error loading data: ${error.message}
                        </td></tr>`;
                });
            }

            function displayReportData(data) {
                if (!data || data.length === 0) {
                    document.getElementById('tableBody').innerHTML = `
                        <tr><td colspan="6" class="text-center text-muted">
                            <i class="fas fa-info-circle me-2"></i>No records found for the selected period
                        </td></tr>`;
                    return;
                }

                let html = '';
                data.forEach(function (item) {
                    const createdOn = item.created_on ? new Date(item.created_on) : null;
                    const formattedDate = createdOn
                        ? createdOn.toLocaleDateString('en-GB', {
                            day: '2-digit', month: 'short', year: 'numeric',
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                          })
                        : '-';

                    const operation = item.operation || '-';
                    const operationClass = operation.toLowerCase().includes('open')
                        ? 'operation-badge operation-open'
                        : operation.toLowerCase().includes('close')
                        ? 'operation-badge operation-close'
                        : 'operation-badge';

                    const deviceClass = getDeviceClass(item.device);

                    html += `
                        <tr>
                            <td><strong>${item.id}</strong></td>
                            <td><span class="device-badge ${deviceClass}">${item.device || '-'}</span></td>
                            <td><span class="${operationClass}">${operation}</span></td>
                            <td>${item.remark || '-'}</td>
                            <td>${item.created_by || '-'}</td>
                            <td>${formattedDate}</td>
                        </tr>`;
                });

                document.getElementById('tableBody').innerHTML = html;
            }

            window.exportReport = function () {
                let url = '@Url.Action("ExportManualGateReport", "Reports")' +
                    '?filterType=' + encodeURIComponent(currentFilter);
                if (currentStartDate && currentEndDate) {
                    url += '&startDate=' + encodeURIComponent(currentStartDate) +
                           '&endDate='   + encodeURIComponent(currentEndDate);
                }
                window.location.href = url;
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => filterReport('today'));
            } else {
                filterReport('today');
            }
        })();
    </script>
}
