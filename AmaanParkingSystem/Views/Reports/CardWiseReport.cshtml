@{
    ViewData["Title"] = "Card Wise Report";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker.min.css" />

<div class="container my-4">
    <h3>Card Wise Report</h3>
    <div class="mb-3 position-relative">
        <input id="cardSearch" type="text" class="form-control form-control-lg"
               placeholder="Search Card Name/Number..." autocomplete="off" />
        <div id="cardResults" class="list-group position-absolute" style="z-index:1000;"></div>
    </div>
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#rangeTab">By Date Range</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#monthTab">By Month & Year</a>
        </li>
    </ul>
    <div class="tab-content border rounded px-3 py-3 bg-light">
        <div class="tab-pane fade show active" id="rangeTab">
            <div class="row mb-2">
                <div class="col-md-4">
                    <label>From</label>
                    <input id="dateFrom" type="text" class="form-control" placeholder="Start date" />
                </div>
                <div class="col-md-4">
                    <label>To</label>
                    <input id="dateTo" type="text" class="form-control" placeholder="End date" />
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="monthTab">
            <div class="row mb-2">
                <div class="col-md-3">
                    <label>Month</label>
                    <select id="monthSelect" class="form-select">
                        <option value="1">Jan</option>
                        <option value="2">Feb</option>
                        <option value="3">Mar</option>
                        <option value="4">Apr</option>
                        <option value="5">May</option>
                        <option value="6">Jun</option>
                        <option value="7">Jul</option>
                        <option value="8">Aug</option>
                        <option value="9">Sep</option>
                        <option value="10">Oct</option>
                        <option value="11">Nov</option>
                        <option value="12">Dec</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Year</label>
                    <select id="yearSelect" class="form-select">
                        @for (var y = 2020; y <= DateTime.Now.Year; y++)
                        {
                            <option>@y</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 align-self-end">
                    <button class="btn btn-outline-primary btn-sm me-1" id="thisMonthBtn">This Month</button>
                    <button class="btn btn-outline-primary btn-sm me-1" id="lastMonthBtn">Previous Month</button>
                    <button class="btn btn-outline-secondary btn-sm me-1" id="thisYearBtn">This Year</button>
                    <button class="btn btn-outline-secondary btn-sm" id="lastYearBtn">Previous Year</button>
                </div>
            </div>
        </div>
    </div>
    <div class="my-3">
        <button class="btn btn-success" id="showBtn">Show</button>
        <button class="btn btn-outline-dark" id="exportBtn">Export</button>
    </div>
    <div id="reportTable"></div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"></script>
<script>
    const columns = [
        { title: "#", field: null },
        { title: "ID", field: "id" },
        { title: "Transaction ID", field: "transaction_id" },
        { title: "Card Number", field: "cardno" },
        { title: "Card Name", field: "card_name" },
        { title: "Card Type", field: "card_type" },
        { title: "Entry Date", field: "entry_time", type: "date" },
        { title: "Entry Time", field: "entry_time", type: "time" },
        { title: "Exit Date", field: "exit_time", type: "date" },
        { title: "Exit Time", field: "exit_time", type: "time" },
        { title: "Park Time", field: "park_time_total" },
        { title: "Ad.", field: "additional_charges" },
        { title: "Validation Time", field: "validation_time" },
        { title: "Re.", field: "revalidation_time" },
        { title: "Charge", field: "charges" },
        { title: "Ad.", field: "addn_chgs" },
        { title: "Remark", field: "remark" },
        { title: "Reason", field: "reason" },
        { title: "Source", field: "pay_source" },
        { title: "Pay Mode", field: "pay_mode" },
        { title: "Paid", field: "paid_amount" },
        { title: "FOC Amount", field: "discount_amount" },
        { title: "Cr.", field: "balance_to_collect" }
    ];
    let currentTableData = [];
    $(function () {
        $('#cardSearch').on('input', function () {
            let q = $(this).val();
            if (q.length < 1) return $('#cardResults').hide();
            $.get('/CardWiseReport/SearchCards?q=' + encodeURIComponent(q), function (res) {
                let box = $('#cardResults').html('');
                res.forEach(card => {
                    box.append(`<a href="#" class="list-group-item list-group-item-action" data-cardno="${card.cardno}" data-cardname="${card.cardname}">${card.cardname} (${card.cardno})</a>`);
                });
                box.show();
            });
        });
        $('#cardResults').on('click', 'a', function (e) {
            e.preventDefault();
            $('#cardSearch').val($(this).data('cardname'));
            $('#cardSearch').data('cardno', $(this).data('cardno'));
            $('#cardResults').hide();
        });
        $('#dateFrom, #dateTo').datepicker({ format: 'dd-M-yyyy', autoclose: true, todayHighlight: true });
        $('#thisMonthBtn').click(function () {
            let d = new Date();
            $('#monthSelect').val(d.getMonth() + 1);
            $('#yearSelect').val(d.getFullYear());
        });
        $('#lastMonthBtn').click(function () {
            let d = new Date();
            d.setMonth(d.getMonth() - 1);
            $('#monthSelect').val(d.getMonth() + 1);
            $('#yearSelect').val(d.getFullYear());
        });
            $('#thisYearBtn').click(function () {
        const d = new Date();
        $('#yearSelect').val(d.getFullYear());
        $('#monthSelect').val('');
        // optional: switch to Month tab if not already
        $('.nav-tabs a[href="#monthTab"]').tab('show');
    });

    $('#lastYearBtn').click(function () {
        const d = new Date();
        $('#yearSelect').val(d.getFullYear() - 1);
        $('#monthSelect').val('');
        $('.nav-tabs a[href="#monthTab"]').tab('show');
    });

        $('#showBtn').click(function () {
            let activeTab = $('.nav-tabs .active').attr('href');
            let req = {
                Card: $('#cardSearch').val(),
                From: null, To: null, Month: null, Year: null
            };
               if (activeTab === '#rangeTab') {
        req.From = $('#dateFrom').val();
        req.To = $('#dateTo').val();
    } else {
        const month = $('#monthSelect').val();
        const year = $('#yearSelect').val();

        if (month) {
            // Month & Year mode: use month/year filter (existing behavior)
            req.Month = parseInt(month, 10);
            req.Year = parseInt(year || new Date().getFullYear(), 10);
        } else if (year) {
            // Year-only mode:
            // If This Year button pressed -> Jan 1 of selected year to TODAY
            // If Previous Year button pressed -> Jan 1 to Dec 31 of that year
            const y = parseInt(year, 10);
            const now = new Date();
            const todayIso = now.toISOString().substring(0, 10); // yyyy-MM-dd

            req.From = `01-Jan-${y}`;
            if (y === now.getFullYear()) {
                // this year → till today
                req.To = todayIso;
            } else {
                // previous year or older → full year
                req.To = `31-Dec-${y}`;
            }
        }
    }
            $.ajax({
                url: '/CardWiseReport/GetReport',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(req),
                success: function (data) {
                    currentTableData = data;
                    let html = '<table class="table table-bordered table-sm"><thead><tr>';
                    columns.forEach(col => html += `<th>${col.title}</th>`);
                    html += '</tr></thead><tbody>';
                    data.forEach((row, i) => {
                        html += '<tr>';
                        columns.forEach((col, j) => {
                            if (col.field === null) { html += `<td>${i + 1}</td>`; }
                            else if (col.type === 'date' && row[col.field]) {
                                html += `<td>${formatDate(row[col.field])}</td>`;
                            } else if (col.type === 'time' && row[col.field]) {
                                html += `<td>${formatTime(row[col.field])}</td>`;
                            } else {
                                html += `<td>${row[col.field] ?? ""}</td>`;
                            }
                        });
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    $('#reportTable').html(html);
                }
            });
        });
        $('#exportBtn').click(function() {
            if (!currentTableData || currentTableData.length === 0) {
                alert("No data to export!");
                return;
            }
            let csv = columns.map(col => `"${col.title}"`).join(',') + "\n";
            currentTableData.forEach((row, i) => {
                let line = columns.map((col, j) => {
                    if (col.field === null) return (i + 1).toString();
                    if (col.type === 'date' && row[col.field]) return `"${formatDate(row[col.field])}"`;
                    if (col.type === 'time' && row[col.field]) return `"${formatTime(row[col.field])}"`;
                    return `"${row[col.field] ?? ""}"`;
                });
                csv += line.join(',') + "\n";
            });
            let blob = new Blob([csv], { type: "text/csv" });
            let url = URL.createObjectURL(blob);
            let a = document.createElement("a");
            a.href = url;
            a.download = "CardWiseReport.csv";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        });
        function formatDate(dtstr) {
            let d = new Date(dtstr);
            if (isNaN(d)) return "";
            return d.toLocaleDateString('en-GB');
        }
        function formatTime(dtstr) {
            let d = new Date(dtstr);
            if (isNaN(d)) return "";
            return d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
        }
    });
</script>
